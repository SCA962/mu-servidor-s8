+
+    /// <inheritdoc/>
+    protected override void InitializeDropItemGroups()
+    {
+        base.InitializeDropItemGroups();
+
+        // The boss materials of Data/Item/ItemDrop.txt: nine rows which each tie one material to
+        // one boss of this map, all with DropRate 1000. The package's DropRate scale is read as
+        // parts per million (the only reading which matches an anchor present in both sources: the
+        // Dark Horse and Dark Raven spirits are 1000 there and 0.001 in Pets.cs), so 1000 -> 0.1 %.
+        // Measured before applying: the chance sum of a monster of this map stays at 0.8701, below
+        // 1, so the groups which were already there are not diluted at all (see
+        // servidor/estudios/conversor-s8/lo-que-falta/5-items-y-drops-hechos.md).
+        this.CreateBossMaterialDropGroup(454, 180, "Ice Walker's Mane");
+        this.CreateBossMaterialDropGroup(455, 181, "Mammoth's Bundle of Fur");
+        this.CreateBossMaterialDropGroup(456, 182, "Giant's Icicle");
+        this.CreateBossMaterialDropGroup(457, 183, "Coolutin's Poison");
+        this.CreateBossMaterialDropGroup(458, 184, "Iron Knight's Heart");
+        this.CreateBossMaterialDropGroup(562, 185, "Dark Mammoth's Horn");
+        this.CreateBossMaterialDropGroup(563, 186, "Dark Giant's Axe");
+        this.CreateBossMaterialDropGroup(564, 187, "Dark Coolutin's Blood");
+        this.CreateBossMaterialDropGroup(565, 188, "Dark Iron Knight's Sword");
+    }
+
+    /// <summary>
+    /// Ties one boss material to the monster which drops it.
+    /// </summary>
+    /// <param name="monsterNumber">The number of the monster which drops it.</param>
+    /// <param name="itemNumber">The number of the material inside item group 14.</param>
+    /// <param name="description">The description of the group.</param>
+    /// <remarks>
+    /// It quietly does nothing if the monster or the item isn't there, so that a partially
+    /// initialized configuration can't make the map initializer throw.
+    /// </remarks>
+    private void CreateBossMaterialDropGroup(short monsterNumber, short itemNumber, string description)
+    {
+        var monster = this.GameConfiguration.Monsters.FirstOrDefault(m => m.Number == monsterNumber);
+        var item = this.GameConfiguration.Items.FirstOrDefault(i => i.Group == 14 && i.Number == itemNumber);
+        if (monster is null || item is null)
+        {
+            return;
+        }
+
+        var dropItemGroup = this.Context.CreateNew<DropItemGroup>();
+        dropItemGroup.SetGuid(Number, monsterNumber);
+        dropItemGroup.Chance = 0.001;
+        dropItemGroup.Description = description;
+        dropItemGroup.Monster = monster;
+        dropItemGroup.PossibleItems.Add(item);
+
+        monster.DropItemGroups.Add(dropItemGroup);
+        this.GameConfiguration.DropItemGroups.Add(dropItemGroup);
+    }
+}
