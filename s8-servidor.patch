diff --git a/src/Persistence/Initialization/Updates/AddElementalSystemUpdatePlugIn.cs b/src/Persistence/Initialization/Updates/AddElementalSystemUpdatePlugIn.cs
new file mode 100644
index 00000000..8dde6eed
--- /dev/null
+++ b/src/Persistence/Initialization/Updates/AddElementalSystemUpdatePlugIn.cs
@@ -0,0 +1,138 @@
+﻿// <copyright file="AddElementalSystemUpdatePlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.Persistence.Initialization.Updates;
+
+using System.Reflection;
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.AttributeSystem;
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.DataModel.Configuration.Items;
+using MUnique.OpenMU.GameLogic.Attributes;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// Mete el sistema elemental de la Season 8 en una base que ya existe.
+/// </summary>
+/// <remarks>
+/// Los inicializadores solo corren cuando la base se crea de cero, asi que un servidor que ya esta
+/// andando necesita esto para tener los atributos elementales, el hueco 236, los 15 pentagramas,
+/// los 5 errtels, los valores elementales de los bichos, los drops y las mezclas de la Maquina del
+/// Caos.
+/// <para>
+/// No repite el codigo de los inicializadores: agrega lo que ellos dan por hecho (los atributos, los
+/// dos tipos de opcion y el tipo de hueco) y luego los llama tal cual. Asi una base nueva y una
+/// vieja acaban con exactamente lo mismo, que es justo lo que fallaba cuando se escribian dos veces.
+/// </para>
+/// </remarks>
+[PlugIn]
+[Display(Name = PlugInName, Description = PlugInDescription)]
+[Guid("C41E7A85-2B93-4D06-9F1C-58E4A7D30B62")]
+public class AddElementalSystemUpdatePlugIn : UpdatePlugInBase
+{
+    /// <summary>
+    /// The plug-in name.
+    /// </summary>
+    internal const string PlugInName = "Add the Season 8 elemental system";
+
+    /// <summary>
+    /// The plug-in description.
+    /// </summary>
+    internal const string PlugInDescription = "This update adds the pentagram slot, the 15 pentagrams, the 5 errtels with their options, the elemental values of every monster, the elemental damage channel, the drops and the three errtel craftings of the Chaos Machine.";
+
+    /// <summary>
+    /// El numero de GUID del tipo de hueco del pentagrama. Los que hay van del 1 al 10 mas el 100
+    /// y el 101 de las dos manos, asi que el 11 y el 12 estan libres; se usa el 12, el mismo que
+    /// pone SlotTypesInitializer, para que una base nueva y una vieja queden iguales.
+    /// </summary>
+    private const short PentagramSlotTypeNumber = 12;
+
+    /// <inheritdoc />
+    public override string Name => PlugInName;
+
+    /// <inheritdoc />
+    public override string Description => PlugInDescription;
+
+    /// <inheritdoc />
+    public override UpdateVersion Version => UpdateVersion.AddElementalSystem;
+
+    /// <inheritdoc />
+    public override string DataInitializationKey => VersionSeasonSix.DataInitialization.Id;
+
+    /// <inheritdoc />
+    public override bool IsMandatory => false;
+
+    /// <inheritdoc />
+    public override DateTime CreatedAt => new(2026, 09, 16, 23, 0, 0, DateTimeKind.Utc);
+
+    /// <inheritdoc />
+    protected override ValueTask ApplyAsync(IContext context, GameConfiguration gameConfiguration)
+    {
+        AddMissingAttributes(context, gameConfiguration);
+        AddMissingOptionTypes(context, gameConfiguration);
+        AddPentagramSlotType(context, gameConfiguration);
+
+        new VersionSeasonSix.Items.Pentagrams(context, gameConfiguration).Initialize();
+        new VersionSeasonSix.ElementalSystem(context, gameConfiguration).Initialize();
+
+        return ValueTask.CompletedTask;
+    }
+
+    /// <summary>
+    /// Agrega las definiciones de atributo que la base vieja no tiene.
+    /// </summary>
+    /// <remarks>
+    /// Se recorre <see cref="Stats"/> entero en vez de listar los 38 a mano: si manana se agrega
+    /// otro, este update lo mete solo y no hay dos listas que se puedan separar.
+    /// </remarks>
+    private static void AddMissingAttributes(IContext context, GameConfiguration gameConfiguration)
+    {
+        var existing = gameConfiguration.Attributes.Select(a => a.Id).ToHashSet();
+        var attributes = typeof(Stats)
+            .GetProperties(BindingFlags.Public | BindingFlags.Static | BindingFlags.DeclaredOnly)
+            .Where(p => p.PropertyType == typeof(AttributeDefinition))
+            .Select(p => p.GetValue(typeof(Stats)))
+            .OfType<AttributeDefinition>()
+            .Where(a => !existing.Contains(a.Id));
+
+        foreach (var attribute in attributes)
+        {
+            var persistent = context.CreateNew<AttributeDefinition>(attribute.Id, attribute.Designation, attribute.Description);
+            persistent.MaximumValue = attribute.MaximumValue;
+            gameConfiguration.Attributes.Add(persistent);
+        }
+    }
+
+    private static void AddMissingOptionTypes(IContext context, GameConfiguration gameConfiguration)
+    {
+        foreach (var optionType in new[] { ItemOptionTypes.PentagramElement, ItemOptionTypes.Errtel })
+        {
+            if (gameConfiguration.ItemOptionTypes.Any(t => t.Id == optionType.Id))
+            {
+                continue;
+            }
+
+            var persistent = context.CreateNew<ItemOptionType>();
+            persistent.Id = optionType.Id;
+            persistent.Name = optionType.Name;
+            persistent.Description = optionType.Description;
+            persistent.IsVisible = optionType.IsVisible;
+            gameConfiguration.ItemOptionTypes.Add(persistent);
+        }
+    }
+
+    private static void AddPentagramSlotType(IContext context, GameConfiguration gameConfiguration)
+    {
+        if (gameConfiguration.ItemSlotTypes.Any(st => st.ItemSlots.Contains(InventoryConstants.PentagramSlot)))
+        {
+            return;
+        }
+
+        var pentagram = context.CreateNew<ItemSlotType>();
+        pentagram.SetGuid(PentagramSlotTypeNumber);
+        pentagram.Description = "Pentagram";
+        pentagram.ItemSlots.Add(InventoryConstants.PentagramSlot);
+        gameConfiguration.ItemSlotTypes.Add(pentagram);
+    }
+}
