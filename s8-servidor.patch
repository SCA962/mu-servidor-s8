+        // The package's DropRate scale isn't documented in any of its files. It is read here as
+        // parts per million, which is the only reading that matches an anchor present in both
+        // sources (the Dark Horse and Dark Raven spirits are 1000 there and 0.001 in Pets.cs).
+        // The other two candidate anchors would make it 3 and 10 times higher, so this is the
+        // conservative end on purpose.
+        this.CreateMaterialDropGroup(1, 12, 144, "Mithril Fragment", 0.02);      // DropRate 20000
+        this.CreateMaterialDropGroup(2, 12, 146, "Elixir Fragment", 0.0025);     // DropRate 2500
+        this.CreateMaterialDropGroup(3, 12, 150, "Jewel Combination Frame", 0.001);
+        this.CreateMaterialDropGroup(4, 12, 151, "Spirit Powder", 0.001);
+    }
