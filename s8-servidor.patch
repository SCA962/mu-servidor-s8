+    /// <inheritdoc/>
+    protected override void InitializeDropItemGroups()
+    {
+        base.InitializeDropItemGroups();
+
+        // The four mix materials the Season 8 package drops on this map, from
+        // Data/Item/ItemDrop.txt rows 11 to 14: map 91, monster level 88 to 150.
+        // The package's DropRate scale isn't documented in any of its files. It is read here as
+        // parts per million, which is the only reading that matches an anchor present in both
+        // sources (the Dark Horse and Dark Raven spirits are 1000 there and 0.001 in Pets.cs).
+        // The other two candidate anchors would make it 3 and 10 times higher, so this is the
+        // conservative end on purpose.
+        this.CreateMaterialDropGroup(1, 12, 144, "Mithril Fragment", 0.02);      // DropRate 20000
+        this.CreateMaterialDropGroup(2, 12, 146, "Elixir Fragment", 0.0025);     // DropRate 2500
+        this.CreateMaterialDropGroup(3, 12, 150, "Jewel Combination Frame", 0.001);
+        this.CreateMaterialDropGroup(4, 12, 151, "Spirit Powder", 0.001);
+    }
+
+    /// <summary>
+    /// Creates one drop item group for a single material and hangs it on this map.
+    /// </summary>
+    /// <param name="number">The number of the group inside this map, for its deterministic id.</param>
+    /// <param name="itemGroup">The group of the item which drops.</param>
+    /// <param name="itemNumber">The number of the item which drops.</param>
+    /// <param name="description">The description of the group.</param>
+    /// <param name="chance">The drop chance.</param>
+    private void CreateMaterialDropGroup(byte number, byte itemGroup, short itemNumber, string description, double chance)
+    {
+        var item = this.GameConfiguration.Items.First(i => i.Group == itemGroup && i.Number == itemNumber);
+        var dropItemGroup = this.Context.CreateNew<DropItemGroup>();
+        dropItemGroup.SetGuid(this.MapNumber, number);
+        dropItemGroup.Chance = chance;
+        dropItemGroup.Description = description;
+        dropItemGroup.MinimumMonsterLevel = 88;
+        dropItemGroup.MaximumMonsterLevel = 150;
+        dropItemGroup.PossibleItems.Add(item);
+
+        this.MapDefinition!.DropItemGroups.Add(dropItemGroup);
+        this.GameConfiguration.DropItemGroups.Add(dropItemGroup);
+    }
+}
