@@ -0,0 +1,93 @@
+﻿// <copyright file="MiningTable.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.Mining;
+
+/// <summary>
+/// The numbers of the 'Jewel of Pandora' mining system, transcribed from the original
+/// <c>Data/Mining.txt</c> of the Season 8 server package (15 rows, dated 13-10-2014).
+/// </summary>
+/// <remarks>
+/// The file has the columns <c>Index Stage Value ItemRate ItemIndex ItemCount BonusItemRate
+/// BonusItemIndex BonusItemCount</c>, where <c>Value</c> is the durability the pick loses per
+/// attempt, the rates are per 10.000 and <c>ItemIndex 7181</c> is the Jewel of Bless (group 14,
+/// number 13). The same table is published by Webzen in the official game guide, row by row.
+/// The rates are flat 47,5 % on all five stages, which is how the package simplified the per-stage
+/// curve of the original.
+/// </remarks>
+public static class MiningTable
+{
+    /// <summary>
+    /// The monster number of the small (blue) mining zone.
+    /// </summary>
+    public const ushort SmallZoneNumber = 605;
+
+    /// <summary>
+    /// The monster number of the medium (purple) mining zone.
+    /// </summary>
+    public const ushort MediumZoneNumber = 606;
+
+    /// <summary>
+    /// The monster number of the large (golden) mining zone.
+    /// </summary>
+    public const ushort LargeZoneNumber = 607;
+
+    /// <summary>
+    /// The number of stages of a mining chain.
+    /// </summary>
+    public const byte MaximumStage = 5;
+
+    /// <summary>
+    /// The divisor of all rates of this table, so that 4750 means 47,5 %.
+    /// </summary>
+    public const int RateDivisor = 10000;
+
+    private static readonly MiningZoneConfiguration Small = new(
+        SmallZoneNumber,
+        durabilityCost: 2,
+        successRate: 4750,
+        jewelsPerStage: new[] { 1, 3, 7, 16, 33 },
+        giftRate: 250,
+        giftJewels: 100);
+
+    private static readonly MiningZoneConfiguration Medium = new(
+        MediumZoneNumber,
+        durabilityCost: 4,
+        successRate: 4750,
+        jewelsPerStage: new[] { 2, 6, 15, 34, 67 },
+        giftRate: 190,
+        giftJewels: 400);
+
+    private static readonly MiningZoneConfiguration Large = new(
+        LargeZoneNumber,
+        durabilityCost: 8,
+        successRate: 4750,
+        jewelsPerStage: new[] { 4, 12, 29, 65, 125 },
+        giftRate: 180,
+        giftJewels: 1000);
+
+    /// <summary>
+    /// Gets the configuration of a mining zone by its monster number.
+    /// </summary>
+    /// <param name="monsterNumber">The monster number of the zone, 605 to 607.</param>
+    /// <returns>The configuration, or <see langword="null"/> when the number is not a mining zone.</returns>
+    public static MiningZoneConfiguration? GetConfiguration(ushort monsterNumber)
+    {
+        return monsterNumber switch
+        {
+            SmallZoneNumber => Small,
+            MediumZoneNumber => Medium,
+            LargeZoneNumber => Large,
+            _ => null,
+        };
+    }
+
+    /// <summary>
+    /// Determines whether the given monster number is one of the three mining zones.
+    /// </summary>
+    /// <param name="monsterNumber">The monster number.</param>
+    /// <returns><see langword="true"/> when it's a mining zone.</returns>
+    public static bool IsMiningZone(ushort monsterNumber)
+        => monsterNumber is SmallZoneNumber or MediumZoneNumber or LargeZoneNumber;
+}
