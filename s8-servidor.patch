@@ -0,0 +1,203 @@
+﻿// <copyright file="PentagramChatCommandPlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.PlugIns.ChatCommands;
+
+using System.Runtime.InteropServices;
+using System.Text;
+using MUnique.OpenMU.DataModel.Configuration.Items;
+using MUnique.OpenMU.DataModel.Entities;
+using MUnique.OpenMU.GameLogic.Attributes;
+using MUnique.OpenMU.GameLogic.Views;
+using MUnique.OpenMU.GameLogic.Views.Inventory;
+using MUnique.OpenMU.Interfaces;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// Pone y saca el pentagrama, y cuenta que lleva puesto.
+/// </summary>
+/// <remarks>
+/// El pentagrama vive en el hueco 236, que el cliente de Season 6 no dibuja: su rejilla de items se
+/// acaba en el 203 y de ahi para arriba es la tienda personal. Mientras no haya un parche de
+/// cliente que le anada ese hueco, este comando es la forma de ponerselo y quitarselo.
+/// <para>
+/// Es un interruptor a proposito: si no llevas ninguno, se pone el primero que encuentre en el
+/// inventario; si llevas uno, se lo devuelve al inventario. Asi no hay que saberse el numero de
+/// casilla, que el jugador no ve por ninguna parte.
+/// </para>
+/// </remarks>
+[Guid("3B7F1A62-9C4D-4E58-8A31-7D0E6B2F5C14")]
+[PlugIn]
+[Display(Name = PlugInName, Description = PlugInDescription)]
+[ChatCommandHelp(Command, typeof(Arguments), MinimumStatus)]
+public class PentagramChatCommandPlugIn : ChatCommandPlugInBase<PentagramChatCommandPlugIn.Arguments>
+{
+    /// <summary>
+    /// The plug-in name.
+    /// </summary>
+    internal const string PlugInName = "Pentagram chat command";
+
+    /// <summary>
+    /// The plug-in description.
+    /// </summary>
+    internal const string PlugInDescription = "Equips or removes the pentagram, which lives in the item slot 236 that the Season 6 client does not draw.";
+
+    private const string Command = "/pentagrama";
+    private const CharacterStatus MinimumStatus = CharacterStatus.Normal;
+
+    private static readonly string[] ElementNames = { "sin elemento", "fuego", "agua", "tierra", "viento", "oscuridad" };
+
+    private static readonly string[] ErrtelNames = { "Anger", "Blessing", "Integrity", "Divinity", "Gale" };
+
+    /// <inheritdoc />
+    public override string Key => Command;
+
+    /// <inheritdoc />
+    public override CharacterStatus MinCharacterStatusRequirement => MinimumStatus;
+
+    /// <inheritdoc />
+    protected override async ValueTask DoHandleCommandAsync(Player player, Arguments arguments)
+    {
+        if (player.PentagramStorage is not { } pentagramStorage || player.Inventory is not { } inventory)
+        {
+            return;
+        }
+
+        if (pentagramStorage.EquippedPentagram is { } equipped)
+        {
+            await this.TakeOffAsync(player, pentagramStorage, inventory, equipped).ConfigureAwait(false);
+            return;
+        }
+
+        var candidate = inventory.Items.FirstOrDefault(i => ErrtelHelper.IsPentagram(i.Definition));
+        if (candidate is null)
+        {
+            await ShowAsync(player, "No tienes ningun pentagrama en el inventario.").ConfigureAwait(false);
+            return;
+        }
+
+        if (!player.CompliesRequirements(candidate))
+        {
+            // El camino normal de equipar (MoveItemAction) comprueba esto, pero al hueco 236 no
+            // llega: GetStorageInfo lo desvia al PentagramStorage antes, asi que la comprobacion
+            // de "esto es equiparse algo" no se cumple nunca para el 236. Sin esta linea un
+            // personaje de nivel 1 se pondria el Kundun's Seal Scroll, que pide 300.
+            await ShowAsync(player, $"Te falta nivel para {candidate.Definition?.Name}.").ConfigureAwait(false);
+            return;
+        }
+
+        EnsureElement(player, candidate);
+
+        var previousSlot = candidate.ItemSlot;
+        await inventory.RemoveItemAsync(candidate).ConfigureAwait(false);
+        if (!await pentagramStorage.AddItemAsync(InventoryConstants.PentagramSlot, candidate).ConfigureAwait(false))
+        {
+            // No deberia pasar: el hueco estaba vacio. Se devuelve a donde estaba y se avisa.
+            await inventory.AddItemAsync(previousSlot, candidate).ConfigureAwait(false);
+            await ShowAsync(player, "No se pudo poner el pentagrama.").ConfigureAwait(false);
+            return;
+        }
+
+        await player.InvokeViewPlugInAsync<IItemRemovedPlugIn>(p => p.RemoveItemAsync(previousSlot)).ConfigureAwait(false);
+        await ShowAsync(player, this.Describe(player, candidate, true)).ConfigureAwait(false);
+    }
+
+    /// <summary>
+    /// Si el pentagrama no trae elemento, se le echa uno a suertes y se le queda.
+    /// </summary>
+    /// <remarks>
+    /// El elemento se reparte al azar cuando el item CAE, en <c>DefaultDropGenerator</c>. Un
+    /// pentagrama creado por comando (<c>/item</c>) no pasa por ahi y saldria sin elemento, o sea
+    /// sin dano elemental y sin que nada avise. Como el unico camino para ponerselo es este
+    /// comando, se arregla aqui.
+    /// </remarks>
+    private static void EnsureElement(Player player, Item pentagram)
+    {
+        if (pentagram.Definition is not { } definition)
+        {
+            return;
+        }
+
+        if (pentagram.ItemOptions.Any(link => link.ItemOption?.OptionType == ItemOptionTypes.PentagramElement))
+        {
+            return;
+        }
+
+        var possible = definition.PossibleItemOptions
+            .SelectMany(o => o.PossibleOptions)
+            .Where(o => o.OptionType == ItemOptionTypes.PentagramElement)
+            .ToList();
+        if (possible.Count == 0)
+        {
+            return;
+        }
+
+        var link = player.PersistenceContext.CreateNew<ItemOptionLink>();
+        link.ItemOption = possible[Rand.NextInt(0, possible.Count)];
+        link.Level = 0;
+        pentagram.ItemOptions.Add(link);
+    }
+
+    private static ValueTask ShowAsync(Player player, string message)
+    {
+        return player.InvokeViewPlugInAsync<IShowMessagePlugIn>(p => p.ShowMessageAsync(message, MessageType.BlueNormal));
+    }
+
+    private async ValueTask TakeOffAsync(Player player, PentagramStorage pentagramStorage, IStorage inventory, Item equipped)
+    {
+        if (inventory.CheckInvSpace(equipped) is not { } freeSlot)
+        {
+            await ShowAsync(player, "No hay sitio en el inventario para guardar el pentagrama.").ConfigureAwait(false);
+            return;
+        }
+
+        await pentagramStorage.RemoveItemAsync(equipped).ConfigureAwait(false);
+        if (!await inventory.AddItemAsync(freeSlot, equipped).ConfigureAwait(false))
+        {
+            await pentagramStorage.AddItemAsync(InventoryConstants.PentagramSlot, equipped).ConfigureAwait(false);
+            await ShowAsync(player, "No se pudo guardar el pentagrama.").ConfigureAwait(false);
+            return;
+        }
+
+        await player.InvokeViewPlugInAsync<IItemAppearPlugIn>(p => p.ItemAppearAsync(equipped)).ConfigureAwait(false);
+        await ShowAsync(player, this.Describe(player, equipped, false)).ConfigureAwait(false);
+    }
+
+    private string Describe(Player player, Item pentagram, bool isEquipped)
+    {
+        var builder = new StringBuilder();
+        builder.Append(isEquipped ? "Llevas puesto: " : "Guardado: ");
+        builder.Append(pentagram.Definition?.Name);
+        if (pentagram.Level > 0)
+        {
+            builder.Append(" +").Append(pentagram.Level);
+        }
+
+        if (isEquipped)
+        {
+            var element = (int)player.Attributes![Stats.Element];
+            builder.Append(" (").Append(ElementNames[Math.Clamp(element, 0, ElementNames.Length - 1)]).Append(')');
+
+            var mounted = new List<string>();
+            for (var socketIndex = 0; socketIndex < ErrtelHelper.ErrtelCount; socketIndex++)
+            {
+                var options = ErrtelHelper.GetErrtelOptions(pentagram, socketIndex);
+                if (options.Count > 0)
+                {
+                    mounted.Add($"{ErrtelNames[socketIndex]} +{options[0].Level}");
+                }
+            }
+
+            builder.Append(mounted.Count > 0 ? ". Errtels: " + string.Join(", ", mounted) : ". Sin errtels.");
+            builder.Append($" Dano elemental {(int)player.Attributes[Stats.ElementalDamageMin]}~{(int)player.Attributes[Stats.ElementalDamageMax]}, defensa {(int)player.Attributes[Stats.ElementalDefense]}.");
+        }
+
+        return builder.ToString();
+    }
+
+    /// <summary>
+    /// El comando no lleva argumentos: es un interruptor.
+    /// </summary>
+    public class Arguments : ArgumentsBase;
+}
