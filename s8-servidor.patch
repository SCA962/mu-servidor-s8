+    /// <summary>
+    /// Initializes a new instance of the <see cref="ElementalSystem"/> class.
+    /// </summary>
+    /// <param name="context">The context.</param>
+    /// <param name="gameConfiguration">The game configuration.</param>
+    public ElementalSystem(IContext context, GameConfiguration gameConfiguration)
+        : base(context, gameConfiguration)
+    {
+    }
+
+    /// <inheritdoc />
+    public override void Initialize()
+    {
+        var byNumber = new Dictionary<short, MonsterDefinition>();
+        foreach (var monster in this.GameConfiguration.Monsters)
+        {
+            byNumber[monster.Number] = monster;
+        }
+
+        var values = new Dictionary<short, Dictionary<AttributeDefinition, float>>();
+
+        for (var i = 0; i < ElementalDefenses.Length; i += 2)
+        {
+            var number = (short)ElementalDefenses[i];
+            if (byNumber.ContainsKey(number))
+            {
+                GetOrAdd(values, number)[Stats.ElementalDefense] = ElementalDefenses[i + 1];
+            }
+        }
+
+        for (var i = 0; i < ElementalMonsters.Length; i += 7)
+        {
+            var number = (short)ElementalMonsters[i];
+            if (!byNumber.ContainsKey(number))
+            {
+                continue;
+            }
+
+            var attributes = GetOrAdd(values, number);
+            attributes[Stats.Element] = ElementalMonsters[i + 1];
+            attributes[Stats.ElementalPattern] = ElementalMonsters[i + 2];
+            attributes[Stats.ElementalDamageMin] = ElementalMonsters[i + 3];
+            attributes[Stats.ElementalDamageMax] = ElementalMonsters[i + 4];
+            attributes[Stats.ElementalAttackSuccessRate] = ElementalMonsters[i + 5];
+            attributes[Stats.ElementalDefenseSuccessRate] = ElementalMonsters[i + 6];
+        }
+
+        foreach (var (number, attributes) in values)
+        {
+            byNumber[number].AddAttributes(attributes, this.Context, this.GameConfiguration);
+        }
+
+        this.AddElementalRatesToCharacterClasses();
+        this.CreateDrops(byNumber);
+    }
+
+    /// <summary>
+    /// Cuelga los pentagramas y los errtels de los bichos elementales.
+    /// </summary>
+    /// <remarks>
+    /// La guia EX700 de Webzen: "The Pentagram Items can be dropped from elemental monsters in
+    /// Acheron and boss monsters in the continent of MU". Los de grado alto salen de los jefes.
+    /// <para>
+    /// Los errtels del original NO caen: se fabrican a partir de Mithril, que sale de los bichos
+    /// elementales, con el NPC Adniel. Esa cadena (fragmentos, Mithril, Elixir, Adniel) no esta
+    /// puesta, asi que aqui caen directos de los mismos bichos. Es la unica libertad grande que se
+    /// toma este apartado, y va dicha.
+    /// </para>
+    /// </remarks>
+    private void CreateDrops(Dictionary<short, MonsterDefinition> byNumber)
+    {
+        // Acheron y Debenter, bichos normales: los pentagramas de andar por casa.
+        var commonPentagrams = this.CreateDropGroup(
+            1,
+            "Pentagrams (elemental monsters)",
+            0.005,
+            Enumerable.Range(200, 8).Select(n => (short)n));
+
+        // Los jefes elementales: los de grado alto.
+        var bossPentagrams = this.CreateDropGroup(
+            2,
+            "Pentagrams (elemental bosses)",
+            0.08,
+            Enumerable.Range(208, 7).Select(n => (short)n));
+
+        var commonErrtels = this.CreateDropGroup(
+            3,
+            "Errtels (elemental monsters)",
+            0.01,
+            Enumerable.Range(0, 5).Select(i => (short)(221 + (i * 10))));
+
+        var bossErrtels = this.CreateDropGroup(
+            4,
+            "Errtels (elemental bosses)",
+            0.10,
+            Enumerable.Range(0, 5).Select(i => (short)(221 + (i * 10))));
+
+        // Bichos normales de Acheron y Debenter.
+        foreach (var number in new short[] { 586, 587, 588, 589, 590, 591, 608, 609, 610 })
+        {
+            if (byNumber.TryGetValue(number, out var monster))
+            {
+                monster.DropItemGroups.Add(commonPentagrams);
+                monster.DropItemGroups.Add(commonErrtels);
+            }
+        }
+
+        // Los diez jefes elementales.
+        foreach (var number in new short[] { 592, 593, 594, 595, 596, 611, 612, 613, 614, 615 })
+        {
+            if (byNumber.TryGetValue(number, out var monster))
+            {
+                monster.DropItemGroups.Add(bossPentagrams);
+                monster.DropItemGroups.Add(bossErrtels);
+            }
+        }
+    }
+
+    private DropItemGroup CreateDropGroup(short number, string description, double chance, IEnumerable<short> itemNumbers)
+    {
+        var group = this.Context.CreateNew<DropItemGroup>();
+        group.SetGuid(ItemOptionDefinitionNumbers.Pentagram, number);
+        group.Description = description;
+        group.Chance = chance;
+        group.ItemLevel = 0;
+        foreach (var itemNumber in itemNumbers)
+        {
+            if (this.GameConfiguration.Items.FirstOrDefault(i => i.Group == 12 && i.Number == itemNumber) is { } item)
+            {
+                group.PossibleItems.Add(item);
+            }
+        }
+
+        this.GameConfiguration.DropItemGroups.Add(group);
+        return group;
+    }
+
+    /// <summary>
+    /// Le da a cada clase su tasa de acierto y de defensa elemental.
+    /// </summary>
+    /// <remarks>
+    /// La descompilacion del binario oficial calcula la tasa de acierto elemental asi:
+    /// <c>(3 * Agilidad / 2) + (5 * Nivel) + (Fuerza / 4)</c>, y la de defensa como la agilidad
+    /// partida por un divisor que depende de la clase. Eso es, caracter por caracter, la misma
+    /// formula que OpenMU ya usa para <see cref="Stats.AttackRatePvm"/> y
+    /// <see cref="Stats.DefenseRatePvm"/>. Asi que en vez de repetirla (y arriesgarse a que las dos
+    /// copias se separen con el tiempo) se cuelga de la que ya hay: cada clase mantiene sus propios
+    /// numeros y el sistema elemental los hereda.
+    /// </remarks>
+    private void AddElementalRatesToCharacterClasses()
+    {
+        foreach (var characterClass in this.GameConfiguration.CharacterClasses)
+        {
+            // Sin esta guarda, correr el update dos veces (una aplicacion a medias, una
+            // restauracion parcial) duplicaria las dos relaciones y dejaria las tasas elementales
+            // al doble, callando.
+            if (characterClass.AttributeCombinations.Any(c => c.TargetAttribute?.Id == Stats.ElementalAttackSuccessRate.Id))
+            {
+                continue;
+            }
+
+            characterClass.AttributeCombinations.Add(CharacterClassHelper.CreateAttributeRelationship(
+                this.Context,
+                this.GameConfiguration,
+                Stats.ElementalAttackSuccessRate,
+                1.0f,
+                Stats.AttackRatePvm));
+            characterClass.AttributeCombinations.Add(CharacterClassHelper.CreateAttributeRelationship(
+                this.Context,
+                this.GameConfiguration,
+                Stats.ElementalDefenseSuccessRate,
+                1.0f,
+                Stats.DefenseRatePvm));
+        }
+    }
+
+    private static Dictionary<AttributeDefinition, float> GetOrAdd(Dictionary<short, Dictionary<AttributeDefinition, float>> values, short number)
+    {
+        if (!values.TryGetValue(number, out var attributes))
+        {
+            attributes = new Dictionary<AttributeDefinition, float>();
+            values[number] = attributes;
+        }
+
+        return attributes;
+    }
+}
