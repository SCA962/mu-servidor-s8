+
+    /// <summary>
+    /// Creates the global drop group of the Spirit Map Fragment, the entry ticket to Acheron.
+    /// </summary>
+    /// <remarks>
+    /// Data/Item/ItemDrop.txt: index 6801 (13/145), monster level 25 to 150, DropRate 3000. The
+    /// package's DropRate scale isn't documented anywhere in it; it is read here as parts per
+    /// million, which is the only reading that matches an anchor present in both sources (the Dark
+    /// Horse and Dark Raven spirits are 1000 there and 0.001 in Pets.cs). So 3000 -> 0.3 %.
+    /// </remarks>
+    private void CreateSpiritMapFragmentDropGroup()
