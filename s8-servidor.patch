+﻿// <copyright file="ErrtelHelper.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic;
+
+using MUnique.OpenMU.DataModel.Configuration.Items;
+using MUnique.OpenMU.DataModel.Entities;
+
+/// <summary>
+/// Lo que comparten el pentagrama y los errtels.
+/// </summary>
+public static class ErrtelHelper
+{
+    /// <summary>
+    /// El grupo de los pentagramas y los errtels.
+    /// </summary>
+    public const byte Group = 12;
+
+    /// <summary>
+    /// El primer pentagrama (Muren's Book of Magic).
+    /// </summary>
+    public const short FirstPentagramNumber = 200;
+
+    /// <summary>
+    /// El ultimo pentagrama (Kundun's Seal Scroll).
+    /// </summary>
+    public const short LastPentagramNumber = 214;
+
+    /// <summary>
+    /// El primer errtel (Errtel of Anger).
+    /// </summary>
+    public const short FirstErrtelNumber = 221;
+
+    /// <summary>
+    /// Cuantos numeros de item hay entre un errtel y el siguiente.
+    /// </summary>
+    public const short ErrtelNumberStep = 10;
+
+    /// <summary>
+    /// Cuantos errtels distintos hay: uno por socket.
+    /// </summary>
+    public const int ErrtelCount = 5;
+
+    /// <summary>
+    /// Determines whether the item definition is a pentagram.
+    /// </summary>
+    /// <param name="definition">The item definition.</param>
+    /// <returns><c>true</c>, if it is a pentagram.</returns>
+    public static bool IsPentagram(ItemDefinition? definition)
+    {
+        return definition is { Group: Group } && definition.Number >= FirstPentagramNumber && definition.Number <= LastPentagramNumber;
+    }
+
+    /// <summary>
+    /// Determines whether the item definition is an errtel.
+    /// </summary>
+    /// <param name="definition">The item definition.</param>
+    /// <returns><c>true</c>, if it is an errtel.</returns>
+    public static bool IsErrtel(ItemDefinition? definition)
+    {
+        return GetSocketIndex(definition) >= 0;
+    }
+
+    /// <summary>
+    /// Devuelve el socket que le toca al errtel, o -1 si el item no es un errtel.
+    /// </summary>
+    /// <param name="definition">The item definition.</param>
+    /// <returns>The socket index, or -1.</returns>
+    /// <remarks>
+    /// El socket no lo elige el jugador: cada errtel tiene el suyo. Anger va al 0, Blessing al 1,
+    /// Integrity al 2, Divinity al 3 y Gale al 4, que es el orden en el que los numera el paquete
+    /// (221, 231, 241, 251 y 261) y tambien el orden de los slots del pentagrama.
+    /// </remarks>
+    public static int GetSocketIndex(ItemDefinition? definition)
+    {
+        if (definition is not { Group: Group })
+        {
+            return -1;
+        }
+
+        var offset = definition.Number - FirstErrtelNumber;
+        if (offset < 0 || offset % ErrtelNumberStep != 0)
+        {
+            return -1;
+        }
+
+        var index = offset / ErrtelNumberStep;
+        return index < ErrtelCount ? index : -1;
+    }
+
+    /// <summary>
+    /// Devuelve el numero de item del errtel que ocupa ese socket.
+    /// </summary>
+    /// <param name="socketIndex">The socket index.</param>
+    /// <returns>The item number.</returns>
+    public static short GetErrtelNumber(int socketIndex)
+    {
+        return (short)(FirstErrtelNumber + (socketIndex * ErrtelNumberStep));
+    }
+
+    /// <summary>
+    /// Devuelve las opciones de errtel que lleva el item en ese socket.
+    /// </summary>
+    /// <param name="item">The item.</param>
+    /// <param name="socketIndex">The socket index.</param>
+    /// <returns>The option links.</returns>
+    public static List<ItemOptionLink> GetErrtelOptions(Item item, int socketIndex)
+    {
+        return item.ItemOptions
+            .Where(link => link.ItemOption?.OptionType == ItemOptionTypes.Errtel && link.Index == socketIndex)
+            .ToList();
+    }
+}
