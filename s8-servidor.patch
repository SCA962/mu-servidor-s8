diff --git a/src/GameLogic/PlayerActions/Mining/MiningAction.cs b/src/GameLogic/PlayerActions/Mining/MiningAction.cs
new file mode 100644
index 00000000..da646c43
--- /dev/null
+++ b/src/GameLogic/PlayerActions/Mining/MiningAction.cs
@@ -0,0 +1,369 @@
+﻿// <copyright file="MiningAction.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.PlayerActions.Mining;
+
+using MUnique.OpenMU.GameLogic.Attributes;
+using MUnique.OpenMU.GameLogic.Mining;
+using MUnique.OpenMU.GameLogic.NPC;
+using MUnique.OpenMU.GameLogic.Views.Inventory;
+using MUnique.OpenMU.GameLogic.Views.Mining;
+
+/// <summary>
+/// The actions of the 'Jewel of Pandora' mining system, which was introduced with Season 8.
+/// </summary>
+/// <remarks>
+/// The chain works like the original: each hit costs durability of the Pandora Pick and either
+/// passes the stage or loses everything accumulated. After stages 1 to 4 the player chooses between
+/// taking the jewels and risking them on the next stage; the fifth stage pays by itself and may add
+/// the 'Gift of Pandora'. The numbers live in <see cref="MiningTable"/>.
+/// </remarks>
+public class MiningAction
+{
+    /// <summary>
+    /// How far the player may stand from the zone, in coordinates.
+    /// </summary>
+    private const int MaximumDistance = 5;
+
+    /// <summary>
+    /// Handles a mining attempt on a zone.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    /// <param name="zoneId">The object id of the zone.</param>
+    /// <param name="zoneClass">The monster number of the zone, as the client sees it.</param>
+    /// <param name="stage">The stage which the client believes the chain is on.</param>
+    public async ValueTask MineAsync(Player player, ushort zoneId, ushort zoneClass, byte stage)
+    {
+        if (this.FindZone(player, zoneId, zoneClass) is not { } zone
+            || MiningTable.GetConfiguration(zoneClass) is not { } configuration)
+        {
+            // La veta ya no esta, murio, o el jugador se alejo. La cadena se cierra en los dos
+            // lados: el cliente ya se resetea con este resultado, y si aqui no se hiciera, el
+            // siguiente clic seria otro rechazo mudo.
+            await this.DropChainAsync(player, consumeZone: false).ConfigureAwait(false);
+            await this.SendHitResultAsync(player, zoneId, zoneClass, stage, 0, MiningResult.StateMismatch).ConfigureAwait(false);
+            return;
+        }
+
+        if (this.GetBlockingState(player) is { } blockingState)
+        {
+            await this.SendHitResultAsync(player, zoneId, zoneClass, stage, 0, blockingState).ConfigureAwait(false);
+            return;
+        }
+
+        var state = player.MiningState;
+        if (state is not null && state.Zone != zone)
+        {
+            // The player moved to another zone without closing the previous chain.
+            await this.DropChainAsync(player, consumeZone: false).ConfigureAwait(false);
+            state = null;
+        }
+
+        if ((state?.Stage ?? 0) != stage || (state?.WaitingForDecision ?? false))
+        {
+            await this.DropChainAsync(player, consumeZone: false).ConfigureAwait(false);
+            await this.SendHitResultAsync(player, zoneId, zoneClass, stage, 0, MiningResult.StateMismatch).ConfigureAwait(false);
+            return;
+        }
+
+        if (this.GetEquippedPick(player) is not { } pick || pick.Durability < configuration.DurabilityCost)
+        {
+            await this.SendHitResultAsync(player, zoneId, zoneClass, stage, 0, MiningResult.NoPickOrDurability).ConfigureAwait(false);
+            return;
+        }
+
+        if (!zone.TryReserve(player))
+        {
+            await this.SendHitResultAsync(player, zoneId, zoneClass, stage, 0, MiningResult.ZoneInUse).ConfigureAwait(false);
+            return;
+        }
+
+        var nextStage = (byte)(stage + 1);
+        var possibleReward = configuration.GetJewelsOfStage(nextStage)
+                             + (nextStage == MiningTable.MaximumStage ? configuration.GiftJewels : 0);
+        if (this.CountFreeInventorySlots(player) < MiningRewardPacker.CountRequiredSlots(possibleReward))
+        {
+            // No cabe lo que podria salir de la fase siguiente. El salto gordo esta en la ultima
+            // de la veta dorada: pasar de 8 huecos a 43, porque ahi entra el Gift of Pandora.
+            //
+            // Si ya hay joyas acumuladas NO se tira la cadena: se deja el cartel abierto para que
+            // el jugador pueda cobrarlas. Tirarla seria quitarle sin avisar lo que ya habia
+            // ganado, que es justo lo que este sistema no debe hacer salvo cuando falla la tirada.
+            if (state is not null && state.JewelCount > 0)
+            {
+                state.WaitingForDecision = true;
+                await this.SendHitResultAsync(player, zoneId, zoneClass, state.Stage, state.JewelCount, MiningResult.NotEnoughSpace).ConfigureAwait(false);
+                return;
+            }
+
+            await this.DropChainAsync(player, consumeZone: false).ConfigureAwait(false);
+            await this.SendHitResultAsync(player, zoneId, zoneClass, stage, 0, MiningResult.NotEnoughSpace).ConfigureAwait(false);
+            return;
+        }
+
+        state ??= new MiningState(zone, configuration);
+        player.MiningState = state;
+
+        if (pick.DecreaseDurability(configuration.DurabilityCost))
+        {
+            await player.InvokeViewPlugInAsync<IItemDurabilityChangedPlugIn>(p => p.ItemDurabilityChangedAsync(pick, false)).ConfigureAwait(false);
+        }
+
+        if (!Rand.NextRandomBool(configuration.SuccessRate, MiningTable.RateDivisor))
+        {
+            await this.DropChainAsync(player, consumeZone: false).ConfigureAwait(false);
+            await this.SendHitResultAsync(player, zoneId, zoneClass, stage, 0, MiningResult.Failed).ConfigureAwait(false);
+            return;
+        }
+
+        state.Stage = nextStage;
+        state.JewelCount = configuration.GetJewelsOfStage(nextStage);
+
+        if (nextStage < MiningTable.MaximumStage)
+        {
+            state.WaitingForDecision = true;
+            await this.SendHitResultAsync(player, zoneId, zoneClass, nextStage, state.JewelCount, MiningResult.Success).ConfigureAwait(false);
+            return;
+        }
+
+        var withGift = Rand.NextRandomBool(configuration.GiftRate, MiningTable.RateDivisor);
+        if (withGift)
+        {
+            state.JewelCount += configuration.GiftJewels;
+        }
+
+        var paid = await this.PayRewardAsync(player, state.JewelCount).ConfigureAwait(false);
+        await this.SendHitResultAsync(player, zoneId, zoneClass, nextStage, state.JewelCount, paid ? MiningResult.SuccessFinalStage : MiningResult.NotEnoughSpace).ConfigureAwait(false);
+
+        if (paid && withGift)
+        {
+            await player.GameContext.SendGlobalMessageAsync(
+                string.Format("{0} has just received the Gift of Pandora: {1} Jewels of Bless!", player.Name, configuration.GiftJewels),
+                Interfaces.MessageType.GoldenCenter).ConfigureAwait(false);
+        }
+
+        await this.DropChainAsync(player, consumeZone: paid).ConfigureAwait(false);
+    }
+
+    /// <summary>
+    /// Handles the answer of the dialog which asks whether to take the jewels or to keep mining.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    /// <param name="zoneId">The object id of the zone.</param>
+    /// <param name="zoneClass">The monster number of the zone.</param>
+    /// <param name="stage">The stage which the client believes the chain is on.</param>
+    /// <param name="cashOut"><c>true</c>, when the player wants the jewels; <c>false</c>, when the next stage should be rolled.</param>
+    public async ValueTask DecideAsync(Player player, ushort zoneId, ushort zoneClass, byte stage, bool cashOut)
+    {
+        var state = player.MiningState;
+        if (state is null
+            || !state.WaitingForDecision
+            || state.Stage != stage
+            || state.Zone.Id != zoneId)
+        {
+            await this.DropChainAsync(player, consumeZone: false).ConfigureAwait(false);
+            await player.InvokeViewPlugInAsync<IMiningViewPlugIn>(p => p.ShowMiningRewardResultAsync(zoneId, zoneClass, this.GetMapNumber(player), stage, MiningResult.StateMismatch)).ConfigureAwait(false);
+            return;
+        }
+
+        if (!cashOut)
+        {
+            // The player keeps mining: the next hit request continues the chain.
+            state.WaitingForDecision = false;
+            return;
+        }
+
+        var paid = await this.PayRewardAsync(player, state.JewelCount).ConfigureAwait(false);
+        await player.InvokeViewPlugInAsync<IMiningViewPlugIn>(p => p.ShowMiningRewardResultAsync(zoneId, zoneClass, this.GetMapNumber(player), stage, paid ? MiningResult.Success : MiningResult.NotEnoughSpace)).ConfigureAwait(false);
+
+        if (paid)
+        {
+            await this.DropChainAsync(player, consumeZone: true).ConfigureAwait(false);
+        }
+    }
+
+    /// <summary>
+    /// Ends a mining chain because the player walked away or closed the dialog. Everything
+    /// accumulated is lost and the zone is consumed.
+    /// </summary>
+    /// <remarks>
+    /// Ojo con la diferencia, que no es la misma regla en los dos casos: **abandonar** consume la
+    /// veta (es lo que hace el original, que le pone la vida a cero), pero **fallar la tirada** no,
+    /// y eso es decision nuestra: no encontre fuente que diga lo que hace el S8 al fallar, y dejar
+    /// la veta permite reintentar en el mismo sitio. Hoy este metodo no lo llama nadie, porque el
+    /// cliente no manda el paquete de abandonar; la reserva se suelta sola por caducidad
+    /// (MiningZone.ReservationTimeout).
+    /// </remarks>
+    /// <param name="player">The player.</param>
+    /// <param name="zoneId">The object id of the zone.</param>
+    public async ValueTask EndAsync(Player player, ushort zoneId)
+    {
+        if (player.MiningState is not { } state || state.Zone.Id != zoneId)
+        {
+            return;
+        }
+
+        await this.DropChainAsync(player, consumeZone: true).ConfigureAwait(false);
+    }
+
+    /// <summary>
+    /// Ends the mining chain of a player without telling the client, for example when the player
+    /// leaves the map or disconnects.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    public ValueTask CancelAsync(Player player) => this.DropChainAsync(player, consumeZone: false);
+
+    private async ValueTask DropChainAsync(Player player, bool consumeZone)
+    {
+        if (player.MiningState is not { } state)
+        {
+            return;
+        }
+
+        player.MiningState = null;
+        if (consumeZone)
+        {
+            await state.Zone.ConsumeAsync(player).ConfigureAwait(false);
+        }
+        else
+        {
+            state.Zone.Release(player);
+        }
+    }
+
+    private async ValueTask<bool> PayRewardAsync(Player player, int jewelCount)
+    {
+        if (player.Inventory is not { } inventory || jewelCount <= 0)
+        {
+            return false;
+        }
+
+        var reward = MiningRewardPacker.Split(jewelCount);
+        if (this.CountFreeInventorySlots(player) < reward.Count)
+        {
+            return false;
+        }
+
+        var packedDefinition = player.GameContext.Configuration.Items.FirstOrDefault(
+            i => i.Group == ItemConstants.PackedJewelOfBless.Group && i.Number == ItemConstants.PackedJewelOfBless.Number);
+        var jewelDefinition = player.GameContext.Configuration.Items.FirstOrDefault(
+            i => i.Group == ItemConstants.JewelOfBless.Group && i.Number == ItemConstants.JewelOfBless.Number);
+        if (packedDefinition is null || jewelDefinition is null)
+        {
+            player.Logger.LogWarning("Mining reward can't be paid: the Jewel of Bless or its package is missing from the configuration.");
+            return false;
+        }
+
+        var allPaid = true;
+        foreach (var entry in reward)
+        {
+            var definition = entry.IsPackage ? packedDefinition : jewelDefinition;
+            var item = player.PersistenceContext.CreateNew<Item>();
+            item.Definition = definition;
+            item.Level = entry.IsPackage ? entry.Level : (byte)0;
+            item.Durability = definition.Durability;
+            if (await inventory.AddItemAsync(item).ConfigureAwait(false))
+            {
+                await player.InvokeViewPlugInAsync<IItemAppearPlugIn>(p => p.ItemAppearAsync(item)).ConfigureAwait(false);
+            }
+            else
+            {
+                // No deberia pasar: el hueco se comprueba antes de cada intento y otra vez aqui.
+                // Si pasa, se dice, porque decirle "cobrado" a alguien que recibio menos de lo que
+                // gano es la clase de fallo que no se nota hasta que alguien lleva la cuenta.
+                await player.PersistenceContext.DeleteAsync(item).ConfigureAwait(false);
+                player.Logger.LogWarning(
+                    "Mining reward: couldn't add {0} of {1} items to the inventory of {2}.",
+                    reward.Count(e => e.IsPackage == entry.IsPackage),
+                    reward.Count,
+                    player.Name);
+                allPaid = false;
+            }
+        }
+
+        return allPaid;
+    }
+
+    private MiningZone? FindZone(Player player, ushort zoneId, ushort zoneClass)
+    {
+        if (player.CurrentMap?.GetObject(zoneId) is not MiningZone zone
+            || !zone.IsAlive
+            || zone.Definition.Number != zoneClass
+            || !player.IsInRange(zone.Position, MaximumDistance))
+        {
+            return null;
+        }
+
+        return zone;
+    }
+
+    private MiningResult? GetBlockingState(Player player)
+    {
+        if (player.Attributes?[Stats.TransformationSkin] > 0)
+        {
+            return MiningResult.Transformed;
+        }
+
+        if (player.ShopStorage?.StoreOpen ?? false)
+        {
+            return MiningResult.PrivateStoreOpen;
+        }
+
+        var currentState = player.PlayerState.CurrentState;
+        if (currentState == PlayerState.TradeRequested
+            || currentState == PlayerState.TradeOpened
+            || currentState == PlayerState.TradeButtonPressed
+            || currentState == PlayerState.NpcDialogOpened)
+        {
+            return MiningResult.Busy;
+        }
+
+        return null;
+    }
+
+    /// <summary>
+    /// Gets the Pandora Pick which the player has equipped in a hand, if there is one.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    /// <returns>The pick, or <see langword="null"/> when there is none equipped.</returns>
+    /// <remarks>
+    /// Both hand slots are checked on purpose, and this is worth knowing: the game client and
+    /// OpenMU name the hands the other way round. The client has
+    /// <c>EQUIPMENT_WEAPON_RIGHT = 0</c> and <c>EQUIPMENT_WEAPON_LEFT = 1</c>, while
+    /// <see cref="InventoryConstants"/> has <c>LeftHandSlot = 0</c> and <c>RightHandSlot = 1</c>.
+    /// The pick is defined with slot 0, so it equips into inventory slot 0, which OpenMU calls the
+    /// left hand and the client calls the right hand. Looking only at
+    /// <see cref="InventoryConstants.RightHandSlot"/> meant never finding it, and the player got
+    /// "not enough durability" with a brand new pick at 255 out of 255.
+    /// </remarks>
+    private Item? GetEquippedPick(Player player)
+    {
+        if (player.Inventory is not { } inventory)
+        {
+            return null;
+        }
+
+        return IsPandoraPick(inventory.GetItem(InventoryConstants.LeftHandSlot))
+               ?? IsPandoraPick(inventory.GetItem(InventoryConstants.RightHandSlot));
+    }
+
+    private static Item? IsPandoraPick(Item? item)
+    {
+        if (item?.Definition is not { } definition
+            || definition.Group != ItemConstants.PandoraPick.Group
+            || definition.Number != ItemConstants.PandoraPick.Number)
+        {
+            return null;
+        }
+
+        return item;
+    }
+
+    private int CountFreeInventorySlots(Player player) => player.Inventory?.FreeSlots.Count() ?? 0;
+
+    private byte GetMapNumber(Player player) => (byte)(player.CurrentMap?.Definition.Number ?? 0);
+
+    private ValueTask SendHitResultAsync(Player player, ushort zoneId, ushort zoneClass, byte stage, int jewelCount, MiningResult result)
+        => player.InvokeViewPlugInAsync<IMiningViewPlugIn>(p => p.ShowMiningHitResultAsync(zoneId, zoneClass, this.GetMapNumber(player), stage, jewelCount, result));
+}
