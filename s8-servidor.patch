+    /// <summary>
+    /// The inventory slot of the pentagram, the elemental item of Season 8.
+    /// </summary>
+    /// <remarks>
+    /// Va fuera del rango contiguo de equipo a proposito. Meterlo como hueco 12 obligaria a
+    /// renumerar TODO lo que hay del 12 en adelante, o sea cada item guardado de cada jugador, y
+    /// ademas crece el paquete de apariencia, que tiene tamano fijo. El 236 es el primer numero
+    /// libre detras de la tienda personal (12 de equipo + 64 de inventario + 128 de las cuatro
+    /// extensiones + 32 de tienda = 236) y `ItemSlot` es un byte, asi que cabe de sobra.
+    ///
+    /// No es capacidad nueva: la tienda personal ya funciona asi, como una vista con desplazamiento
+    /// sobre el mismo <see cref="Character.Inventory"/> (ver ShopStorage). El pentagrama es lo mismo
+    /// con un hueco en vez de 32.
+    /// </remarks>
+    public static readonly byte PentagramSlot = 236;
+
+    /// <summary>
+    /// Determines whether the given slot holds an item which the character is wearing.
+    /// </summary>
+    /// <param name="itemSlot">The item slot.</param>
+    /// <returns><see langword="true"/> when the item in that slot counts as equipped.</returns>
+    /// <remarks>
+    /// Usar esto y no comparar contra <see cref="LastEquippableItemSlotIndex"/> a mano: el
+    /// pentagrama se lleva puesto pero no esta en el rango contiguo, y los sitios que comparan a
+    /// mano se lo dejan fuera sin avisar (le pasaba a ItemPowerUpFactory, que le quitaba todos sus
+    /// atributos, y a MoveItemAction, que no lo consideraba equipar).
+    /// </remarks>
+    public static bool IsEquippedSlot(byte itemSlot)
+    {
+        return (itemSlot >= FirstEquippableItemSlotIndex && itemSlot <= LastEquippableItemSlotIndex)
+               || itemSlot == PentagramSlot;
+    }
