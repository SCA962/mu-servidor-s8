+    private IncreasableItemOption CreateErrtelOption(short definitionNumber, short number, int rank, byte weight, AttributeDefinition targetAttribute, params float[] values)
+    {
+        var itemOption = this.Context.CreateNew<IncreasableItemOption>();
+        itemOption.SetGuid(definitionNumber, number);
+        itemOption.OptionType = this.GameConfiguration.ItemOptionTypes.First(t => t == ItemOptionTypes.Errtel);
+        itemOption.Number = number;
+        itemOption.SubOptionType = rank;
+        itemOption.Weight = weight;
+
+        // El nivel del errtel va de 0 a 10, asi que la tabla tiene una entrada por cada uno y el
+        // nivel 0 no se queda sin valor.
+        for (var level = 0; level < values.Length; level++)
+        {
+            var optionOfLevel = this.Context.CreateNew<ItemOptionOfLevel>();
+            optionOfLevel.Level = level;
+            var powerUpDefinition = this.Context.CreateNew<PowerUpDefinition>();
+            powerUpDefinition.TargetAttribute = targetAttribute.GetPersistent(this.GameConfiguration);
+            powerUpDefinition.Boost = this.Context.CreateNew<PowerUpDefinitionValue>();
+            powerUpDefinition.Boost.ConstantValue.Value = values[level];
+            powerUpDefinition.Boost.ConstantValue.AggregateType = AggregateType.AddRaw;
+            optionOfLevel.PowerUpDefinition = powerUpDefinition;
+            itemOption.LevelDependentOptions.Add(optionOfLevel);
+            if (level == 0)
+            {
+                itemOption.PowerUpDefinition = powerUpDefinition;
+            }
+        }
+
+        return itemOption;
+    }
