+﻿// <copyright file="Pentagrams.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.Persistence.Initialization.VersionSeasonSix.Items;
+
+using MUnique.OpenMU.AttributeSystem;
+using MUnique.OpenMU.DataModel.Attributes;
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.DataModel.Configuration.Items;
+using MUnique.OpenMU.GameLogic.Attributes;
+
+/// <summary>
+/// Los pentagramas y los errtels del sistema elemental de la Season 8.
+/// </summary>
+/// <remarks>
+/// Todos los numeros salen del propio paquete de servidor Season 8 (Update 32), no de guias:
+/// <list type="bullet">
+/// <item>Data/Item/Item.txt, seccion 12: los 15 pentagramas y los 5 errtels. En esa seccion las
+/// columnas estan reaprovechadas: "Level" es el nivel de personaje que pide, "Defense" es la
+/// defensa elemental, "Durability" es el limite de traspasos y "ReqLevel"/"ReqEnergy" son el dano
+/// elemental minimo y maximo. Se comprobo fila a fila contra la tabla que publico el publisher
+/// licenciado (muonline.ph, guia ex8penta) y cuadra en las diez filas que esa guia trae.</item>
+/// <item>Data/Item/PentagramJewelOption.txt: las 60 filas de opciones de errtel, cada una con sus
+/// once niveles (0 a 10).</item>
+/// </list>
+/// Dos cosas que se dejaron fuera a proposito:
+/// <list type="number">
+/// <item>Las Pentagram Options de PentagramOption.txt. Son un bono que solo se enciende si llevas
+/// errtels de cierto tipo, rango y nivel, y la columna "Type" de esa tabla admite dos lecturas
+/// (tipo de errtel o numero de socket) que no se pudieron separar con la fuente a mano. Meterlas
+/// como bono fijo seria otra cosa distinta, asi que no se meten.</item>
+/// <item>La subida de nivel y de rango de los errtels. Eso vive en la Maquina del Caos.</item>
+/// </list>
+/// </remarks>
+internal class Pentagrams : InitializerBase
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="Pentagrams"/> class.
+    /// </summary>
+    /// <param name="context">The context.</param>
+    /// <param name="gameConfiguration">The game configuration.</param>
+    public Pentagrams(IContext context, GameConfiguration gameConfiguration)
+        : base(context, gameConfiguration)
+    {
+    }
+
+    /// <inheritdoc />
+    public override void Initialize()
+    {
+        var bonusPerLevel = this.CreateBonusPerLevelTable();
+        var elementOptions = this.CreateElementOptions();
+
+        var errtelAngerOptions = this.CreateErrtelAngerOptions();
+        var errtelBlessingOptions = this.CreateErrtelBlessingOptions();
+        var errtelIntegrityOptions = this.CreateErrtelIntegrityOptions();
+        var errtelDivinityOptions = this.CreateErrtelDivinityOptions();
+        var errtelGaleOptions = this.CreateErrtelGaleOptions();
+
+        this.CreatePentagrams(elementOptions, bonusPerLevel);
+        this.CreateErrtel(221, "Errtel of Anger", 2, 2, 110, errtelAngerOptions);
+        this.CreateErrtel(231, "Errtel of Blessing", 2, 2, 115, errtelBlessingOptions);
+        this.CreateErrtel(241, "Errtel of Integrity", 2, 2, 120, errtelIntegrityOptions);
+        this.CreateErrtel(251, "Errtel of Divinity", 2, 2, 125, errtelDivinityOptions);
+        this.CreateErrtel(261, "Errtel of Gale", 2, 2, 130, errtelGaleOptions);
+    }
+
+    private ItemLevelBonusTable CreateBonusPerLevelTable()
+    {
+        // De +1 a +9 suma 3 por nivel; de +10 a +15 suma 4, 5, 6, 7, 8 y 9.
+        var values = new[] { 0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 31, 36, 42, 49, 57, 66 };
+        var table = this.Context.CreateNew<ItemLevelBonusTable>();
+        table.SetGuid(ItemOptionDefinitionNumbers.Pentagram);
+        this.GameConfiguration.ItemLevelBonusTables.Add(table);
+        table.Name = "Pentagram Bonus per Level";
+        for (int level = 0; level < values.Length; level++)
+        {
+            var levelBonus = this.Context.CreateNew<LevelBonus>();
+            levelBonus.Level = level;
+            levelBonus.AdditionalValue = values[level];
