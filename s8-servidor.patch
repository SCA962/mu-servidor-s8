+﻿// <copyright file="AddSeason8MasterSkillTreePlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.Persistence.Initialization.Updates;
+
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.GameLogic.Attributes;
+using MUnique.OpenMU.Persistence.Initialization.Skills;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// Adds the ranks 6 to 9 of the master skill tree to an existing Season 6 database.
+/// </summary>
+/// <remarks>
+/// The tree up to rank 5 is created by <c>VersionSeasonSix.SkillsInitializer</c>, which only
+/// runs when a database is created from scratch. This update adds the 103 rows of the ranks 6 to 9
+/// (180 slots over the seven master classes, 15 of the skills did not exist in OpenMU at all)
+/// on top of a configuration which is already in use, so the characters which already spent master
+/// points keep them.
+/// It does not touch anything which is already there: it only adds skills, master skill definitions
+/// and the stat attributes those definitions need.
+/// </remarks>
+[PlugIn]
+[Display(Name = PlugInName, Description = PlugInDescription)]
+[Guid("BF246CCB-9060-4790-9DCD-21F142D2EBB2")]
+public class AddSeason8MasterSkillTreePlugIn : UpdatePlugInBase
+{
+    /// <summary>
+    /// The plug-in name.
+    /// </summary>
+    internal const string PlugInName = "Add Season 8 master skill tree (ranks 6 to 9)";
+
+    /// <summary>
+    /// The plug-in description.
+    /// </summary>
+    internal const string PlugInDescription = "This update adds the ranks 6 to 9 of the master skill tree, as the Season 8 client shows them.";
+
+    /// <inheritdoc />
+    public override string Name => PlugInName;
+
+    /// <inheritdoc />
+    public override string Description => PlugInDescription;
+
+    /// <inheritdoc />
+    public override UpdateVersion Version => UpdateVersion.AddSeason8MasterSkillTree;
+
+    /// <inheritdoc />
+    public override string DataInitializationKey => VersionSeasonSix.DataInitialization.Id;
+
+    /// <inheritdoc />
+    public override bool IsMandatory => false;
+
+    /// <inheritdoc />
+    public override DateTime CreatedAt => new(2026, 9, 16, 12, 0, 0, DateTimeKind.Utc);
+
+    /// <inheritdoc />
+    protected override ValueTask ApplyAsync(IContext context, GameConfiguration gameConfiguration)
+    {
+        // The 19 attributes the new definitions point at. A database which was created by an
+        // older version does not have all of them, and MasterSkillDefinition.TargetAttribute needs
+        // the persistent instance.
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.ComboBonus);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.CriticalDamageChance);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.DefenseIgnoreChance);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.DoubleDamageChance);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.DrainLifeStrBonusHealing);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.ExcellentDamageChance);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.ExtraProjectiles);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.FullyRecoverHealthAfterHitChance);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.FullyRecoverManaAfterHitChance);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.FullyReflectDamageAfterHitChance);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.MaximumAbility);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.MaximumPhysBaseDmg);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.MaximumWizBaseDmg);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.RavenAttackSpeed);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.TotalAgility);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.TotalEnergy);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.TotalLeadership);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.TotalStrength);
+        this.AddStatIfNotExists(context, gameConfiguration, Stats.TotalVitality);
+
+        if (gameConfiguration.Skills.Any(s => s.Number == (short)SkillNumber.ArmorSetBonusInc))
+        {
+            // The tree is already there; do not add it twice.
+            return ValueTask.CompletedTask;
+        }
+
+        new VersionSeasonSix.SkillsInitializer(context, gameConfiguration).AddSeason8MasterSkillTree();
+        return ValueTask.CompletedTask;
+    }
+}
diff --git a/src/Persistence/Initialization/Updates/AddSeasonEightItemsAndDropsUpdatePlugIn.cs b/src/Persistence/Initialization/Updates/AddSeasonEightItemsAndDropsUpdatePlugIn.cs
new file mode 100644
