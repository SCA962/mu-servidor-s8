+    private void CreatePentagram(short number, string name, byte width, byte height, int levelRequirement, int elementalDamageMin, int elementalDamageMax, int elementalDefense, ItemOptionDefinition elementOptions, ItemLevelBonusTable bonusPerLevel)
+    {
+        var pentagram = this.Context.CreateNew<ItemDefinition>();
+        this.GameConfiguration.Items.Add(pentagram);
+        pentagram.Group = 12;
+        pentagram.Number = number;
+        pentagram.Width = width;
+        pentagram.Height = height;
+        pentagram.Name = name;
+        pentagram.DropLevel = (byte)Math.Min(levelRequirement, 255);
+        pentagram.MaximumItemLevel = 15;
+        pentagram.DropsFromMonsters = false;
+
+        // No se gasta con el uso, pero tiene que ser mayor que cero: la fabrica de atributos
+        // descarta cualquier item con durabilidad 0 sin decir nada.
+        pentagram.Durability = 255;
+        pentagram.ItemSlot = this.GameConfiguration.ItemSlotTypes.First(st => st.ItemSlots.Contains(InventoryConstants.PentagramSlot));
+        pentagram.SetGuid(pentagram.Group, pentagram.Number);
+
+        this.CreateItemRequirementIfNeeded(pentagram, Stats.Level, levelRequirement);
+
+        var minPowerUp = this.CreateItemBasePowerUpDefinition(Stats.ElementalDamageMin, elementalDamageMin, AggregateType.AddRaw);
+        minPowerUp.BonusPerLevelTable = bonusPerLevel;
+        pentagram.BasePowerUpAttributes.Add(minPowerUp);
+
+        var maxPowerUp = this.CreateItemBasePowerUpDefinition(Stats.ElementalDamageMax, elementalDamageMax, AggregateType.AddRaw);
+        maxPowerUp.BonusPerLevelTable = bonusPerLevel;
+        pentagram.BasePowerUpAttributes.Add(maxPowerUp);
+
+        var defensePowerUp = this.CreateItemBasePowerUpDefinition(Stats.ElementalDefense, elementalDefense, AggregateType.AddRaw);
+        defensePowerUp.BonusPerLevelTable = bonusPerLevel;
+        pentagram.BasePowerUpAttributes.Add(defensePowerUp);
+
+        pentagram.PossibleItemOptions.Add(elementOptions);
+
+        foreach (var characterClass in this.GameConfiguration.CharacterClasses)
+        {
+            pentagram.QualifiedCharacters.Add(characterClass);
+        }
+    }
+
+    private void CreateErrtel(short number, string name, byte width, byte height, byte dropLevel, List<ItemOptionDefinition> options)
+    {
+        var errtel = this.Context.CreateNew<ItemDefinition>();
+        this.GameConfiguration.Items.Add(errtel);
+        errtel.Group = 12;
+        errtel.Number = number;
+        errtel.Width = width;
+        errtel.Height = height;
+        errtel.Name = name;
+        errtel.DropLevel = dropLevel;
+        errtel.MaximumItemLevel = 10;
+        errtel.DropsFromMonsters = false;
+        errtel.Durability = 1;
+        errtel.SetGuid(errtel.Group, errtel.Number);
+        foreach (var option in options)
+        {
+            errtel.PossibleItemOptions.Add(option);
+        }
+    }
