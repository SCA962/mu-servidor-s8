+﻿// <copyright file="MiningRewardPacker.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.Mining;
+
+/// <summary>
+/// Splits a mining reward into packages of 30, 20 and 10 jewels plus loose ones, which is what the
+/// original does.
+/// </summary>
+/// <remarks>
+/// The Season 8 code pays with <c>GetRewardCount(count, 30, ...)</c>, then 20, then 10, then single
+/// jewels, and the official screenshot of a 125 jewel reward shows exactly 4 packages of 30 plus 5
+/// loose ones. OpenMU already has the item: 'Packed Jewel of Bless' (group 12, number 30) with
+/// <c>MaximumItemLevel = 2</c>, where level 0, 1 and 2 mean 10, 20 and 30 jewels.
+/// </remarks>
+public static class MiningRewardPacker
+{
+    /// <summary>
+    /// The jewels held by a package of each item level.
+    /// </summary>
+    private static readonly int[] PackageSizes = { 10, 20, 30 };
+
+    /// <summary>
+    /// Splits the given number of jewels into the items which have to be created.
+    /// </summary>
+    /// <param name="jewelCount">The number of jewels to pay.</param>
+    /// <returns>One entry per item, in the order in which they should be created.</returns>
+    public static IReadOnlyList<MiningRewardItem> Split(int jewelCount)
+    {
+        var result = new List<MiningRewardItem>();
+        var remaining = Math.Max(jewelCount, 0);
+
+        for (var level = PackageSizes.Length - 1; level >= 0; level--)
+        {
+            var size = PackageSizes[level];
+            while (remaining >= size)
+            {
+                result.Add(new MiningRewardItem(true, (byte)level));
+                remaining -= size;
+            }
+        }
+
+        for (var i = 0; i < remaining; i++)
+        {
+            result.Add(new MiningRewardItem(false, 0));
+        }
+
+        return result;
+    }
+
+    /// <summary>
+    /// Counts the inventory slots which a reward of the given size needs.
+    /// </summary>
+    /// <param name="jewelCount">The number of jewels to pay.</param>
+    /// <returns>The number of inventory slots.</returns>
+    public static int CountRequiredSlots(int jewelCount) => Split(jewelCount).Count;
+}
diff --git a/src/GameLogic/Mining/MiningState.cs b/src/GameLogic/Mining/MiningState.cs
new file mode 100644
index 00000000..440c4ae7
--- /dev/null
+++ b/src/GameLogic/Mining/MiningState.cs
@@ -0,0 +1,55 @@
+﻿// <copyright file="MiningState.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.Mining;
+
+using MUnique.OpenMU.GameLogic.NPC;
+
+/// <summary>
+/// The state of a mining chain of one player on one zone.
+/// </summary>
+/// <remarks>
+/// It only lives while the player is connected and standing on a chain. It's deliberately not
+/// persisted: the original loses everything accumulated when the player disconnects before taking
+/// the jewels, and so do we.
+/// </remarks>
+public sealed class MiningState
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MiningState"/> class.
+    /// </summary>
+    /// <param name="zone">The zone which is being mined.</param>
+    /// <param name="configuration">The numbers of that zone size.</param>
+    public MiningState(MiningZone zone, MiningZoneConfiguration configuration)
+    {
+        this.Zone = zone;
+        this.Configuration = configuration;
+    }
+
+    /// <summary>
+    /// Gets the zone which is being mined.
+    /// </summary>
+    public MiningZone Zone { get; }
+
+    /// <summary>
+    /// Gets the numbers of the zone size.
+    /// </summary>
+    public MiningZoneConfiguration Configuration { get; }
+
+    /// <summary>
+    /// Gets or sets the stage which the chain has reached, 0 before the first hit.
+    /// </summary>
+    public byte Stage { get; set; }
+
+    /// <summary>
+    /// Gets or sets the jewels accumulated so far, which are lost on a failed attempt.
+    /// </summary>
+    public int JewelCount { get; set; }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether the player is being asked to take the jewels or to
+    /// keep mining. While this is set, only a reward answer is accepted.
+    /// </summary>
+    public bool WaitingForDecision { get; set; }
+}
