+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.Views.Mining;
+
+using MUnique.OpenMU.GameLogic.Mining;
+
+/// <summary>
+/// Interface of a view whose implementation answers the mining packets of the 'Jewel of Pandora'
+/// system.
+/// </summary>
+public interface IMiningViewPlugIn : IViewPlugIn
+{
+    /// <summary>
+    /// Answers a mining attempt.
+    /// </summary>
+    /// <param name="zoneId">The object id of the mining zone.</param>
+    /// <param name="zoneClass">The monster number of the zone, 605 to 607.</param>
+    /// <param name="mapNumber">The map number.</param>
+    /// <param name="stage">The stage the chain reached, 1 to 5.</param>
+    /// <param name="jewelCount">The jewels accumulated so far, which the client shows as a floating number.</param>
+    /// <param name="result">What happened.</param>
+    ValueTask ShowMiningHitResultAsync(ushort zoneId, ushort zoneClass, byte mapNumber, byte stage, int jewelCount, MiningResult result);
+
+    /// <summary>
+    /// Answers the decision of taking the jewels or keeping on mining.
+    /// </summary>
+    /// <param name="zoneId">The object id of the mining zone.</param>
+    /// <param name="zoneClass">The monster number of the zone, 605 to 607.</param>
+    /// <param name="mapNumber">The map number.</param>
+    /// <param name="stage">The stage the chain reached.</param>
+    /// <param name="result">What happened.</param>
+    ValueTask ShowMiningRewardResultAsync(ushort zoneId, ushort zoneClass, byte mapNumber, byte stage, MiningResult result);
+}
