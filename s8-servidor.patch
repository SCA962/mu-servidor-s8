+﻿// <copyright file="MiningZone.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.NPC;
+
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// A mining zone of the 'Jewel of Pandora' mining system, which was introduced with Season 8.
+/// </summary>
+/// <remarks>
+/// It's a blinking spot on the ground of the safe zone of certain maps, not a monster: it stands
+/// still, it can't be attacked with a weapon and it's only used through the mining packets.
+/// It derives from <see cref="AttackableNpcBase"/> for one reason only: the respawn. When a chain
+/// ends, the zone is consumed and comes back after <see cref="MonsterDefinition.RespawnDelay"/>,
+/// which is exactly what the base class already does after a death.
+/// Because <see cref="GetHitNotificationTarget"/> returns <see langword="null"/>, the death gives
+/// no experience, drops nothing and shows no damage number.
+/// </remarks>
+public sealed class MiningZone : AttackableNpcBase, IAttackable
+{
+    /// <summary>
+    /// Cuanto aguanta una reserva sin que el jugador vuelva a picar. Pasado eso, la veta es de
+    /// quien la pida.
+    /// </summary>
+    /// <remarks>
+    /// Hace falta porque el cliente no manda el paquete de abandonar: sin esto, un jugador que
+    /// llega a la fase 2, pulsa «seguir minando» y se va a dar una vuelta por el mismo mapa deja
+    /// la veta bloqueada para todos los demas hasta que se desconecte.
+    /// </remarks>
+    private static readonly TimeSpan ReservationTimeout = TimeSpan.FromSeconds(60);
+
+    private readonly object _minerLock = new();
+
+    private Player? _miner;
+
+    private DateTime _reservedAt;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MiningZone" /> class.
+    /// </summary>
+    /// <param name="spawnInfo">The spawn information.</param>
+    /// <param name="stats">The stats.</param>
+    /// <param name="map">The map on which this instance will spawn.</param>
+    /// <param name="eventStateProvider">The event state provider.</param>
+    /// <param name="plugInManager">The plugin manager.</param>
+    public MiningZone(MonsterSpawnArea spawnInfo, MonsterDefinition stats, GameMap map, IEventStateProvider? eventStateProvider, PlugInManager plugInManager)
+        : base(spawnInfo, stats, map, eventStateProvider, NullDropGenerator.Instance, plugInManager)
+    {
+    }
+
+    /// <summary>
+    /// Gets the player which is currently mining this zone, if there is one.
+    /// </summary>
+    public Player? Miner
+    {
+        get
+        {
+            lock (this._minerLock)
+            {
+                return this._miner;
+            }
+        }
+    }
+
+    /// <summary>
+    /// Tries to reserve this zone for the specified player.
+    /// </summary>
+    /// <param name="player">The player who wants to mine here.</param>
+    /// <returns><see langword="true"/>, when the zone is now reserved for the player; <see langword="false"/>, when somebody else is using it.</returns>
+    public bool TryReserve(Player player)
+    {
+        lock (this._minerLock)
+        {
+            if (this._miner is null || this._miner == player || this.IsStale())
+            {
+                this._miner = player;
+                this._reservedAt = DateTime.UtcNow;
+                return true;
+            }
+
+            return false;
+        }
+    }
+
+    /// <summary>
+    /// Releases the reservation of the specified player, without consuming the zone.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    public void Release(Player player)
+    {
+        lock (this._minerLock)
+        {
+            if (this._miner == player)
+            {
+                this._miner = null;
+            }
+        }
+    }
+
+    /// <summary>
+    /// Consumes this zone, so that it disappears and respawns after its configured delay.
+    /// </summary>
+    /// <param name="player">The player which used the zone up.</param>
+    public async ValueTask ConsumeAsync(Player player)
+    {
+        if (!this.IsAlive)
+        {
+            return;
+        }
+
+        this.Release(player);
+        var damage = (uint)Math.Max(this.Health, 1);
+        await this.HitAsync(new HitInfo(damage, 0, DamageAttributes.Undefined), player, null).ConfigureAwait(false);
+    }
+
+    /// <inheritdoc/>
+    public override ValueTask ReflectDamageAsync(IAttacker reflector, uint damage)
+    {
+        // A mining zone doesn't attack, so it doesn't reflect.
+        return ValueTask.CompletedTask;
+    }
+
+    /// <inheritdoc />
+    public override ValueTask ApplyPoisonDamageAsync(IAttacker initialAttacker, uint damage)
+    {
+        // A mining zone is not an organism which can be poisoned.
+        return ValueTask.CompletedTask;
+    }
+
+    /// <inheritdoc />
+    public override ValueTask ApplyBleedingDamageAsync(IAttacker initialAttacker, uint damage)
+    {
+        // A mining zone is not an organism which can bleed.
+        return ValueTask.CompletedTask;
+    }
+
+    /// <inheritdoc />
+    /// <remarks>A mining zone is never attacked with a weapon; it's only used through the mining packets.</remarks>
+    protected override bool CanBeAttackedBy(IAttacker attacker) => false;
+
+    /// <inheritdoc />
+    /// <remarks>
+    /// Returning <see langword="null"/> keeps the whole reward path of the base class switched off:
+    /// no damage number, no experience, no drop and no party share when the zone is consumed.
+    /// </remarks>
+    protected override Player? GetHitNotificationTarget(IAttacker attacker) => null;
+
+    /// <inheritdoc />
+    protected override void OnRemoveFromMap()
+    {
+        lock (this._minerLock)
+        {
+            this._miner = null;
+        }
+
+        base.OnRemoveFromMap();
+    }
+
+    /// <summary>
+    /// Determines whether the current reservation can be taken away: when the player disconnected,
+    /// walked away to another map, or simply stopped mining without closing the chain.
+    /// </summary>
+    /// <returns><see langword="true"/> when the reservation is stale.</returns>
+    /// <remarks>Only call this while holding <c>_minerLock</c>.</remarks>
+    private bool IsStale()
+    {
+        if (this._miner is not { } miner)
+        {
+            return true;
+        }
+
+        return miner.PlayerState.CurrentState == PlayerState.Disconnected
+               || miner.CurrentMap != this.CurrentMap
+               || DateTime.UtcNow - this._reservedAt > ReservationTimeout;
+    }
+}
