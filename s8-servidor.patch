@@ -0,0 +1,372 @@
+﻿// <copyright file="ErrtelChatCommandPlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.PlugIns.ChatCommands;
+
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.DataModel.Configuration.Items;
+using MUnique.OpenMU.DataModel.Entities;
+using MUnique.OpenMU.GameLogic.Views;
+using MUnique.OpenMU.GameLogic.Views.Inventory;
+using MUnique.OpenMU.Interfaces;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// Monta, saca y sube de nivel los errtels del pentagrama.
+/// </summary>
+/// <remarks>
+/// <para>
+/// Esto iba a ir en la Maquina del Caos, y no puede. <b>El cliente decide solo si te deja mezclar</b>:
+/// <c>CMixRecipeMgr</c> carga las recetas de <c>Data/Local/Mix.bmd</c> y
+/// <c>NewUIMixInventory</c> no manda NADA al servidor si <c>IsReadyToMix()</c> dice que no. O sea
+/// que una mezcla que el servidor conoce pero el fichero del cliente no, es inalcanzable: el boton
+/// no llega ni a pulsarse. Meter las tres recetas en ese fichero significa descifrarlo, entender la
+/// estructura <c>MIX_RECIPE</c> y reescribirlo, y si la estructura no cuadra el cliente muestra
+/// «Version not matched» y <b>se cierra solo</b>.
+/// </para>
+/// <para>
+/// Asi que van por comando, igual que <c>/pentagrama</c>: cero riesgo de cliente y se puede cambiar
+/// a la Maquina del Caos el dia que alguien quiera pagar ese precio, sin tocar nada de esto.
+/// </para>
+/// </remarks>
+[Guid("5D8A3C17-6E42-4B90-A7F5-2C81D934EB06")]
+[PlugIn]
+[Display(Name = PlugInName, Description = PlugInDescription)]
+[ChatCommandHelp(Command, typeof(Arguments), MinimumStatus)]
+public class ErrtelChatCommandPlugIn : ChatCommandPlugInBase<ErrtelChatCommandPlugIn.Arguments>
+{
+    /// <summary>
+    /// The plug-in name.
+    /// </summary>
+    internal const string PlugInName = "Errtel chat command";
+
+    /// <summary>
+    /// The plug-in description.
+    /// </summary>
+    internal const string PlugInDescription = "Mounts, removes and levels up the errtels of the equipped pentagram.";
+
+    private const string Command = "/errtel";
+    private const CharacterStatus MinimumStatus = CharacterStatus.Normal;
+
+    private const byte JewelGroup = 14;
+    private const short JewelOfBlessNumber = 13;
+
+    private static readonly string[] ErrtelNames = { "Anger", "Blessing", "Integrity", "Divinity", "Gale" };
+
+    /// <summary>
+    /// De nivel 0 a 1 hasta de nivel 9 a 10, por tipo de errtel. De muonlinefanz; Webzen nunca
+    /// publico las de la epoca.
+    /// </summary>
+    private static readonly byte[][] LevelUpRates =
+    {
+        new byte[] { 90, 80, 70, 70, 60, 60, 60, 50, 50, 50 }, // Anger
+        new byte[] { 90, 80, 70, 70, 60, 60, 60, 50, 50, 50 }, // Blessing
+        new byte[] { 80, 80, 70, 70, 60, 60, 50, 50, 40, 40 }, // Integrity
+        new byte[] { 80, 80, 70, 70, 60, 60, 50, 50, 40, 40 }, // Divinity
+        new byte[] { 70, 70, 60, 60, 50, 50, 40, 40, 30, 30 }, // Gale
+    };
+
+    /// <inheritdoc />
+    public override string Key => Command;
+
+    /// <inheritdoc />
+    public override CharacterStatus MinCharacterStatusRequirement => MinimumStatus;
+
+    /// <inheritdoc />
+    protected override async ValueTask DoHandleCommandAsync(Player player, Arguments arguments)
+    {
+        if (player.Inventory is not { } inventory || player.PentagramStorage is not { } pentagramStorage)
+        {
+            return;
+        }
+
+        switch (arguments?.Accion?.ToLowerInvariant())
+        {
+            case "sacar":
+                await this.RemoveAsync(player, inventory, pentagramStorage).ConfigureAwait(false);
+                break;
+            case "subir":
+                await this.LevelUpAsync(player, inventory).ConfigureAwait(false);
+                break;
+            default:
+                await this.MountAsync(player, inventory, pentagramStorage).ConfigureAwait(false);
+                break;
+        }
+    }
+
+    private static ValueTask ShowAsync(Player player, string message)
+    {
+        return player.InvokeViewPlugInAsync<IShowMessagePlugIn>(p => p.ShowMessageAsync(message, MessageType.BlueNormal));
+    }
+
+    /// <summary>
+    /// El nivel de verdad del errtel.
+    /// </summary>
+    /// <remarks>
+    /// Un errtel recien caido trae <see cref="Item.Level"/> a 0 pero sus opciones pueden venir a
+    /// nivel 1, 2 o 3, porque el generador de drops le echa a suertes el nivel de cada enlace. Si
+    /// se tomara solo <see cref="Item.Level"/>, subirlo de nivel le BAJARIA las opciones. Se toma
+    /// el mayor de los dos, asi que nunca empeora.
+    /// </remarks>
+    private static byte GetErrtelLevel(Item errtel)
+    {
+        var level = (int)errtel.Level;
+        foreach (var link in errtel.ItemOptions)
+        {
+            if (link.ItemOption?.OptionType == ItemOptionTypes.Errtel && link.Level > level)
+            {
+                level = link.Level;
+            }
+        }
+
+        return (byte)Math.Clamp(level, 0, 10);
+    }
+
+    /// <summary>
+    /// Si el errtel no trae opciones, se le echan a suertes y se le quedan.
+    /// </summary>
+    /// <remarks>
+    /// Las opciones se reparten cuando el item CAE, en <c>DefaultDropGenerator</c>: una por rango,
+    /// segun la probabilidad de ese rango. Un errtel creado por comando (<c>/item 12 221</c>) no
+    /// pasa por ahi y saldria pelado, o sea inservible. Es el mismo caso que el elemento del
+    /// pentagrama y se arregla en el mismo sitio: el unico camino por el que el item se usa.
+    /// </remarks>
+    private static void EnsureOptions(Player player, Item errtel)
+    {
+        if (errtel.Definition is not { } definition || GetErrtelOptions(errtel).Count > 0)
+        {
+            return;
+        }
+
+        foreach (var optionDefinition in definition.PossibleItemOptions)
+        {
+            var possible = optionDefinition.PossibleOptions
+                .Where(o => o.OptionType == ItemOptionTypes.Errtel)
+                .ToList();
+            if (possible.Count == 0 || !Rand.NextRandomBool(optionDefinition.AddChance))
+            {
+                continue;
+            }
+
+            var link = player.PersistenceContext.CreateNew<ItemOptionLink>();
+            link.ItemOption = possible[Rand.NextInt(0, possible.Count)];
+            link.Level = errtel.Level;
+            errtel.ItemOptions.Add(link);
+        }
+    }
+
+    private static List<ItemOptionLink> GetErrtelOptions(Item errtel)
+    {
+        return errtel.ItemOptions.Where(link => link.ItemOption?.OptionType == ItemOptionTypes.Errtel).ToList();
+    }
+
+    private async ValueTask MountAsync(Player player, IStorage inventory, PentagramStorage pentagramStorage)
+    {
+        if (pentagramStorage.EquippedPentagram is not { } pentagram)
+        {
+            await ShowAsync(player, "Primero ponte un pentagrama con /pentagrama.").ConfigureAwait(false);
+            return;
+        }
+
+        var errtel = inventory.Items.FirstOrDefault(i => ErrtelHelper.IsErrtel(i.Definition));
+        if (errtel is null)
+        {
+            await ShowAsync(player, "No tienes ningun errtel en el inventario.").ConfigureAwait(false);
+            return;
+        }
+
+        var socketIndex = ErrtelHelper.GetSocketIndex(errtel.Definition);
+        if (ErrtelHelper.GetErrtelOptions(pentagram, socketIndex).Count > 0)
+        {
+            await ShowAsync(player, $"Ya llevas un Errtel of {ErrtelNames[socketIndex]} montado. Sacalo antes con /errtel sacar.").ConfigureAwait(false);
+            return;
+        }
+
+        EnsureOptions(player, errtel);
+        var options = GetErrtelOptions(errtel);
+        if (options.Count == 0)
+        {
+            // Si ni siquiera despues de echarlas a suertes tiene opciones, es que su definicion no
+            // trae ninguna. Sin esta comprobacion el errtel se consumiria sin montar nada y el
+            // hueco seguiria viendose libre, o sea que se podria repetir sin fin.
+            await ShowAsync(player, "Ese errtel no trae ninguna opcion; no sirve para montar.").ConfigureAwait(false);
+            return;
+        }
+
+        var level = GetErrtelLevel(errtel);
+        foreach (var option in options)
+        {
+            var mounted = player.PersistenceContext.CreateNew<ItemOptionLink>();
+            mounted.ItemOption = option.ItemOption;
+            mounted.Level = level;
+            mounted.Index = socketIndex;
+            pentagram.ItemOptions.Add(mounted);
+        }
+
+        var slot = errtel.ItemSlot;
+        await inventory.RemoveItemAsync(errtel).ConfigureAwait(false);
+        await player.PersistenceContext.DeleteAsync(errtel).ConfigureAwait(false);
+        await player.InvokeViewPlugInAsync<IItemRemovedPlugIn>(p => p.RemoveItemAsync(slot)).ConfigureAwait(false);
+
+        await pentagramStorage.RefreshAsync().ConfigureAwait(false);
+        await ShowAsync(player, $"Montado Errtel of {ErrtelNames[socketIndex]} +{level}. Mira el resultado con /pentagrama.").ConfigureAwait(false);
+    }
+
+    private async ValueTask RemoveAsync(Player player, IStorage inventory, PentagramStorage pentagramStorage)
+    {
+        if (pentagramStorage.EquippedPentagram is not { } pentagram)
+        {
+            await ShowAsync(player, "Primero ponte el pentagrama con /pentagrama.").ConfigureAwait(false);
+            return;
+        }
+
+        var recovered = new List<string>();
+        var lost = new List<string>();
+        var stayed = new List<string>();
+
+        for (var socketIndex = 0; socketIndex < ErrtelHelper.ErrtelCount; socketIndex++)
+        {
+            var mounted = ErrtelHelper.GetErrtelOptions(pentagram, socketIndex);
+            if (mounted.Count == 0)
+            {
+                continue;
+            }
+
+            var level = (byte)Math.Clamp(mounted[0].Level, 0, 10);
+            var definition = player.GameContext.Configuration.Items.FirstOrDefault(
+                i => i.Group == ErrtelHelper.Group && i.Number == ErrtelHelper.GetErrtelNumber(socketIndex));
+            if (definition is null)
+            {
+                continue;
+            }
+
+            if (!Rand.NextRandomBool(50))
+            {
+                await this.DetachAsync(player, pentagram, mounted).ConfigureAwait(false);
+                lost.Add($"{ErrtelNames[socketIndex]} +{level}");
+                continue;
+            }
+
+            var errtel = player.PersistenceContext.CreateNew<Item>();
+            errtel.Definition = definition;
+            errtel.Level = level;
+            errtel.Durability = definition.Durability;
+            foreach (var link in mounted)
+            {
+                var restored = player.PersistenceContext.CreateNew<ItemOptionLink>();
+                restored.ItemOption = link.ItemOption;
+                restored.Level = level;
+                errtel.ItemOptions.Add(restored);
+            }
+
+            if (inventory.CheckInvSpace(errtel) is not { } freeSlot
+                || !await inventory.AddItemAsync(freeSlot, errtel).ConfigureAwait(false))
+            {
+                // No cabe: se queda montado. Antes se borraba en silencio y el jugador solo veia
+                // que le faltaba uno.
+                await player.PersistenceContext.DeleteAsync(errtel).ConfigureAwait(false);
+                stayed.Add($"{ErrtelNames[socketIndex]} +{level}");
+                continue;
+            }
+
+            await this.DetachAsync(player, pentagram, mounted).ConfigureAwait(false);
+            await player.InvokeViewPlugInAsync<IItemAppearPlugIn>(p => p.ItemAppearAsync(errtel)).ConfigureAwait(false);
+            recovered.Add($"{ErrtelNames[socketIndex]} +{level}");
+        }
+
+        if (recovered.Count == 0 && lost.Count == 0 && stayed.Count == 0)
+        {
+            await ShowAsync(player, "El pentagrama no lleva ningun errtel.").ConfigureAwait(false);
+            return;
+        }
+
+        await pentagramStorage.RefreshAsync().ConfigureAwait(false);
+
+        var parts = new List<string>();
+        if (recovered.Count > 0)
+        {
+            parts.Add("recuperados: " + string.Join(", ", recovered));
+        }
+
+        if (lost.Count > 0)
+        {
+            parts.Add("se rompieron: " + string.Join(", ", lost));
+        }
+
+        if (stayed.Count > 0)
+        {
+            parts.Add("sin sitio, siguen montados: " + string.Join(", ", stayed));
+        }
+
+        await ShowAsync(player, string.Join(". ", parts) + ".").ConfigureAwait(false);
+    }
+
+    private async ValueTask DetachAsync(Player player, Item pentagram, List<ItemOptionLink> mounted)
+    {
+        foreach (var link in mounted)
+        {
+            pentagram.ItemOptions.Remove(link);
+            await player.PersistenceContext.DeleteAsync(link).ConfigureAwait(false);
+        }
+    }
+
+    private async ValueTask LevelUpAsync(Player player, IStorage inventory)
+    {
+        var errtel = inventory.Items.FirstOrDefault(i => ErrtelHelper.IsErrtel(i.Definition));
+        if (errtel is null)
+        {
+            await ShowAsync(player, "No tienes ningun errtel en el inventario.").ConfigureAwait(false);
+            return;
+        }
+
+        var socketIndex = ErrtelHelper.GetSocketIndex(errtel.Definition);
+        var level = GetErrtelLevel(errtel);
+        if (level >= 10)
+        {
+            await ShowAsync(player, $"El Errtel of {ErrtelNames[socketIndex]} ya esta a +10.").ConfigureAwait(false);
+            return;
+        }
+
+        var bless = inventory.Items.FirstOrDefault(i => i.Definition is { Group: JewelGroup, Number: JewelOfBlessNumber });
+        if (bless is null)
+        {
+            await ShowAsync(player, "Te falta una Jewel of Bless.").ConfigureAwait(false);
+            return;
+        }
+
+        var blessSlot = bless.ItemSlot;
+        await inventory.RemoveItemAsync(bless).ConfigureAwait(false);
+        await player.PersistenceContext.DeleteAsync(bless).ConfigureAwait(false);
+        await player.InvokeViewPlugInAsync<IItemRemovedPlugIn>(p => p.RemoveItemAsync(blessSlot)).ConfigureAwait(false);
+
+        var rate = LevelUpRates[socketIndex][level];
+        if (!Rand.NextRandomBool(rate))
+        {
+            await ShowAsync(player, $"Fallo ({rate}%). Se perdio la joya; el errtel se queda a +{level}.").ConfigureAwait(false);
+            return;
+        }
+
+        var newLevel = (byte)(level + 1);
+        errtel.Level = newLevel;
+        foreach (var link in GetErrtelOptions(errtel))
+        {
+            link.Level = newLevel;
+        }
+
+        await player.InvokeViewPlugInAsync<IItemUpgradedPlugIn>(p => p.ItemUpgradedAsync(errtel)).ConfigureAwait(false);
+        await ShowAsync(player, $"Errtel of {ErrtelNames[socketIndex]} a +{newLevel} ({rate}% de exito).").ConfigureAwait(false);
+    }
+
+    /// <summary>
+    /// Argumentos del comando: nada (montar), «sacar» o «subir».
+    /// </summary>
+    public class Arguments : ArgumentsBase
+    {
+        /// <summary>
+        /// Gets or sets the action: empty to mount, "sacar" to remove, "subir" to level up.
+        /// </summary>
+        [ValidValues("sacar", "subir")]
+        public string? Accion { get; set; }
+    }
+}
