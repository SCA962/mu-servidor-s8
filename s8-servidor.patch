@@ -0,0 +1,73 @@
+﻿// <copyright file="MiningZoneConfiguration.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.Mining;
+
+/// <summary>
+/// The numbers of one of the three mining zone sizes. See <see cref="MiningTable"/> for the source.
+/// </summary>
+public sealed class MiningZoneConfiguration
+{
+    private readonly int[] _jewelsPerStage;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MiningZoneConfiguration"/> class.
+    /// </summary>
+    /// <param name="monsterNumber">The monster number of the zone.</param>
+    /// <param name="durabilityCost">The durability the pick loses on each attempt.</param>
+    /// <param name="successRate">The chance to pass a stage, per <see cref="MiningTable.RateDivisor"/>.</param>
+    /// <param name="jewelsPerStage">The accumulated jewels of each of the five stages.</param>
+    /// <param name="giftRate">The chance of the 'Gift of Pandora' after the fifth stage, per <see cref="MiningTable.RateDivisor"/>.</param>
+    /// <param name="giftJewels">The jewels of the 'Gift of Pandora'.</param>
+    public MiningZoneConfiguration(ushort monsterNumber, byte durabilityCost, int successRate, int[] jewelsPerStage, int giftRate, int giftJewels)
+    {
+        this.MonsterNumber = monsterNumber;
+        this.DurabilityCost = durabilityCost;
+        this.SuccessRate = successRate;
+        this._jewelsPerStage = jewelsPerStage;
+        this.GiftRate = giftRate;
+        this.GiftJewels = giftJewels;
+    }
+
+    /// <summary>
+    /// Gets the monster number of the zone, 605 to 607.
+    /// </summary>
+    public ushort MonsterNumber { get; }
+
+    /// <summary>
+    /// Gets the durability which the pick loses on each attempt: 2, 4 or 8.
+    /// </summary>
+    public byte DurabilityCost { get; }
+
+    /// <summary>
+    /// Gets the chance to pass a stage, per <see cref="MiningTable.RateDivisor"/>. The package uses
+    /// 4750 on all five stages.
+    /// </summary>
+    public int SuccessRate { get; }
+
+    /// <summary>
+    /// Gets the chance of the 'Gift of Pandora' after the fifth stage, per <see cref="MiningTable.RateDivisor"/>.
+    /// </summary>
+    public int GiftRate { get; }
+
+    /// <summary>
+    /// Gets the jewels of the 'Gift of Pandora', which are added on top of the fifth stage.
+    /// </summary>
+    public int GiftJewels { get; }
+
+    /// <summary>
+    /// Gets the accumulated jewels after passing the specified stage.
+    /// </summary>
+    /// <param name="stage">The stage, 1 to <see cref="MiningTable.MaximumStage"/>.</param>
+    /// <returns>The total jewels of that stage. They replace the previous total, they don't add up.</returns>
+    public int GetJewelsOfStage(byte stage)
+    {
+        if (stage < 1 || stage > this._jewelsPerStage.Length)
+        {
+            return 0;
+        }
+
+        return this._jewelsPerStage[stage - 1];
+    }
+}
