+// </copyright>
+
+namespace MUnique.OpenMU.GameServer.MessageHandler.Mining;
+
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.GameLogic;
+using MUnique.OpenMU.GameLogic.PlayerActions.Mining;
+using MUnique.OpenMU.Network.Packets.ClientToServer;
+using MUnique.OpenMU.Network.PlugIns;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// Handler for the packet which the client sends when the player leaves a mining zone.
+/// </summary>
+[PlugIn]
+[Display(Name = "Mining End Request Handler", Description = "Handler for the packet which ends a mining chain of the Jewel of Pandora system.")]
+[Guid("1A3C9F10-130A-4226-A77A-F15912B2CE3C")]
+[MinimumClient(6, 3, ClientLanguage.Invariant)]
+[BelongsToGroup(MiningGroupHandlerPlugIn.GroupKey)]
+internal class MiningEndRequestHandlerPlugIn : ISubPacketHandlerPlugIn
+{
+    private readonly MiningAction _action = new();
+
+    /// <inheritdoc/>
+    public bool IsEncryptionExpected => false;
+
+    /// <inheritdoc/>
+    public byte Key => MiningEndRequest.SubCode;
+
+    /// <inheritdoc/>
+    public async ValueTask HandlePacketAsync(Player player, Memory<byte> packet)
+    {
+        if (packet.Length < MiningEndRequest.Length)
+        {
+            return;
+        }
+
+        MiningEndRequest request = packet;
+        await this._action.EndAsync(player, request.ZoneId).ConfigureAwait(false);
+    }
+}
