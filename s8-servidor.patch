+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic;
+
+using MUnique.OpenMU.AttributeSystem;
+using MUnique.OpenMU.GameLogic.Attributes;
+
+/// <summary>
+/// El canal de dano elemental de la Season 8, en los dos sentidos: lo que el jugador con pentagrama
+/// le hace al bicho y lo que el bicho elemental le hace al jugador.
+/// </summary>
+/// <remarks>
+/// <para>
+/// <b>Cinco elementos, no siete</b>: fuego, agua, tierra, viento y oscuridad, mas el 0 de quien no
+/// lleva pentagrama. La rueda es circular: cada uno le pega fuerte al siguiente.
+/// </para>
+/// <para>
+/// <b>Son dos tablas, no una.</b> La tabla que publica Webzen (100/120/110/90/80) es el EFECTO NETO,
+/// no la tabla de dano. Debajo hay una de dano y otra de defensa, y el neto sale de dividirlas:
+/// 110/90 = 122% que Webzen redondea a 120%, 105/95 = 110,5% que publica como 110%, y asi las cinco.
+/// Las dos tablas salen de codigo de servidor (samik3k/mu_online_lgnd, Game/PentagramSystem.h) y
+/// coinciden con la descompilacion del binario oficial que trae IGCN marcada "1.1.0.4 decompilation".
+/// </para>
+/// <para>
+/// <b>Aviso sobre la tabla oficial:</b> la que Webzen publico en la guia EX700 esta rota. La columna
+/// del viento es una copia exacta de la de la tierra en las cinco filas, y se delata sola porque
+/// dice viento contra viento 120%, que es imposible. Media internet la copia rota. La reconstruccion
+/// correcta se comprueba contra la propia guia de Webzen (detail/43): "con un pentagrama de fuego
+/// equipado, agua y tierra, que son mas fuertes que el fuego, apareceran arriba, y viento y
+/// oscuridad, que son mas debiles, abajo". Con la tabla rota el viento saldria mas fuerte que el
+/// fuego, contradiciendo a Webzen en su propia guia.
+/// </para>
+/// <para>
+/// <b>Que no se pudo verificar en fuente oficial</b>: Webzen nunca publico ni la formula de dano ni
+/// la de la tasa de acierto elemental. El orden de operaciones de aqui sale de codigo de servidor
+/// privado mas la descompilacion. El bono de PvP es el de la epoca (+30%); el x2 adicional que se
+/// ve hoy es de temporadas posteriores.
+/// </para>
+/// </remarks>
+internal static class ElementalCombat
+{
+    /// <summary>
+    /// Indices: 0 ninguno, 1 fuego, 2 agua, 3 tierra, 4 viento, 5 oscuridad.
+    /// </summary>
+    private const int ElementCount = 6;
+
+    /// <summary>
+    /// Tabla de dano, indexada [atacante, defensor].
+    /// </summary>
+    private static readonly int[,] DamageRelation =
+    {
+        //         nin  fue  agu  tie  vie  osc
+        /* nin */ { 100, 100, 100, 100, 100, 100 },
+        /* fue */ { 090, 100, 090, 095, 105, 110 },
+        /* agu */ { 090, 110, 100, 090, 095, 105 },
+        /* tie */ { 090, 105, 110, 100, 090, 095 },
+        /* vie */ { 090, 095, 105, 110, 100, 090 },
+        /* osc */ { 090, 090, 095, 105, 110, 100 },
+    };
+
+    /// <summary>
+    /// Tabla de defensa, indexada [defensor, atacante].
+    /// </summary>
+    private static readonly int[,] DefenseRelation =
+    {
+        //         nin  fue  agu  tie  vie  osc
+        /* nin */ { 100, 080, 080, 080, 080, 080 },
+        /* fue */ { 100, 100, 090, 095, 105, 110 },
+        /* agu */ { 100, 110, 100, 090, 095, 105 },
+        /* tie */ { 100, 105, 110, 100, 090, 095 },
+        /* vie */ { 100, 095, 105, 110, 100, 090 },
+        /* osc */ { 100, 090, 095, 105, 110, 100 },
+    };
+
+    /// <summary>
+    /// Gets a value indicating whether the defender can only be hurt with elemental damage.
+    /// </summary>
+    /// <param name="defender">The defender.</param>
+    /// <returns><c>true</c>, if only elemental damage hurts it.</returns>
+    /// <remarks>
+    /// Son los diez jefes elementales, los que llevan un 2 en la columna ElementalPattern de
+    /// Monster.txt. La guia EX700 de Webzen lo dice con todas las letras: "Boss monsters can be
+    /// harmed only through elemental damages".
+    /// </remarks>
+    public static bool IsImmuneToPhysicalDamage(IAttackable defender)
+    {
+        return defender.Attributes[Stats.ElementalPattern] >= 2;
+    }
+
+    /// <summary>
+    /// Calculates the elemental damage of one hit.
+    /// </summary>
+    /// <param name="attacker">The attacker.</param>
+    /// <param name="defender">The defender.</param>
+    /// <param name="isPvp">If set to <c>true</c>, both sides are players.</param>
+    /// <param name="isRanged">If set to <c>true</c>, the attack comes from a distance.</param>
+    /// <returns>The elemental damage, zero if there is none or if it missed.</returns>
+    public static int CalculateDamage(IAttacker attacker, IAttackable defender, bool isPvp, bool isRanged)
+    {
+        var attackerElement = GetElement(attacker.Attributes, attacker.Id);
+        if (attackerElement == 0)
+        {
+            // Sin pentagrama (o sin elemento) no hay dano elemental. Es la puerta de entrada.
+            return 0;
+        }
+
+        var minimum = attacker.Attributes[Stats.ElementalDamageMin];
+        var maximum = attacker.Attributes[Stats.ElementalDamageMax];
+        if (maximum <= 0)
+        {
+            return 0;
+        }
+
+        var hitFactor = GetHitFactor(attacker, defender);
+        if (hitFactor <= 0)
+        {
+            return 0;
+        }
+
+        var defenderElement = GetElement(defender.Attributes, defender.Id);
+
+        // Rand.NextInt lanza si min > max. Hoy ninguna configuracion lo produce, pero basta una
+        // fila de la tabla con los dos numeros cambiados para tirar el hilo de combate del mapa.
+        var minimumDamage = (int)Math.Min(minimum, maximum);
+        float damage = Rand.NextInt(minimumDamage, (int)maximum + 1);
+        damage += attacker.Attributes[Stats.ElementalDamageBonus];
+        damage += isPvp ? attacker.Attributes[Stats.ElementalDamageBonusPvp] : attacker.Attributes[Stats.ElementalDamageBonusPvm];
+        damage += isRanged ? attacker.Attributes[Stats.ElementalDamageBonusRanged] : attacker.Attributes[Stats.ElementalDamageBonusMelee];
+
+        var damageMultiplier = 1f
+            + GetVersusMultiplier(attacker.Attributes, defenderElement, true)
+            + (isPvp ? attacker.Attributes[Stats.ElementalDamageMultiplierPvp] : attacker.Attributes[Stats.ElementalDamageMultiplierPvm]);
+        damage *= damageMultiplier;
+
+        var criticalChance = isPvp ? attacker.Attributes[Stats.ElementalCriticalDamageChancePvp] : attacker.Attributes[Stats.ElementalCriticalDamageChancePvm];
+        var excellentChance = isPvp ? attacker.Attributes[Stats.ElementalExcellentDamageChancePvp] : attacker.Attributes[Stats.ElementalExcellentDamageChancePvm];
+        if (Rand.NextRandomBool(excellentChance))
+        {
+            damage = maximum * 1.2f * damageMultiplier;
+        }
+        else if (Rand.NextRandomBool(criticalChance))
+        {
+            damage = maximum * damageMultiplier;
+        }
+        else
+        {
+            // Nada que hacer: se queda con el aleatorio.
+        }
+
+        damage = damage * DamageRelation[attackerElement, defenderElement] / 100f;
+
+        var defense = defender.Attributes[Stats.ElementalDefense];
+        defense += isPvp ? defender.Attributes[Stats.ElementalDefenseBonusPvp] : defender.Attributes[Stats.ElementalDefenseBonusPvm];
+        defense += isRanged ? defender.Attributes[Stats.ElementalDefenseBonusRanged] : defender.Attributes[Stats.ElementalDefenseBonusMelee];
+        defense *= 1f + GetVersusMultiplier(defender.Attributes, attackerElement, false);
+        defense = defense * DefenseRelation[defenderElement, attackerElement] / 100f;
+
+        damage -= defense;
+        if (damage <= 0)
+        {
+            return 0;
+        }
+
+        if (isPvp)
+        {
+            // La nota de la guia EX700: "In PVP, elemental damage is increased by 30%". El x2 que se
+            // ve en los servidores de hoy es de temporadas posteriores, no de esta.
+            damage *= 1.3f;
+        }
+
+        var reduction = isPvp ? defender.Attributes[Stats.ElementalDamageReductionPvp] : defender.Attributes[Stats.ElementalDamageReductionPvm];
+        damage *= 1f - Math.Clamp(reduction, 0f, 0.9f);
+
+        damage *= hitFactor;
+
+        return damage > 0 ? (int)damage : 0;
+    }
+
+    /// <summary>
+    /// Devuelve el elemento, resolviendo el 6 de Monster.txt, que no es un sexto elemento sino
+    /// "al azar entre los cinco". Se reparte por el identificador del bicho, asi que cada uno que
+    /// aparece se queda con su color mientras vive y cambia al reaparecer.
+    /// </summary>
+    private static int GetElement(IAttributeSystem attributes, ushort id)
+    {
+        var element = (int)attributes[Stats.Element];
+        if (element == 6)
+        {
+            return (id % 5) + 1;
+        }
+
+        return element > 0 && element < ElementCount ? element : 0;
+    }
+
+    private static float GetVersusMultiplier(IAttributeSystem attributes, int otherElement, bool isDamage)
+    {
+        return otherElement switch
+        {
+            1 => attributes[isDamage ? Stats.ElementalDamageMultiplierVsFire : Stats.ElementalDefenseMultiplierVsFire],
+            2 => attributes[isDamage ? Stats.ElementalDamageMultiplierVsWater : Stats.ElementalDefenseMultiplierVsWater],
+            3 => attributes[isDamage ? Stats.ElementalDamageMultiplierVsEarth : Stats.ElementalDefenseMultiplierVsEarth],
+            4 => attributes[isDamage ? Stats.ElementalDamageMultiplierVsWind : Stats.ElementalDefenseMultiplierVsWind],
+            5 => attributes[isDamage ? Stats.ElementalDamageMultiplierVsDark : Stats.ElementalDefenseMultiplierVsDark],
+            _ => 0f,
+        };
+    }
+
+    /// <summary>
+    /// Acierto o fallo del golpe elemental. Devuelve 0 si fallo, 1 si entro entero y 0,3 si entro
+    /// de refilon.
+    /// </summary>
+    /// <remarks>
+    /// De la descompilacion: si la tasa de ataque del atacante es menor que la de defensa del
+    /// objetivo, falla el 95% de las veces y el 5% restante entra al 30%. Si es mayor o igual, la
+    /// probabilidad de fallo es defensa dividido ataque.
+    /// </remarks>
+    private static float GetHitFactor(IAttacker attacker, IAttackable defender)
+    {
+        var attackRate = attacker.Attributes[Stats.ElementalAttackSuccessRate]
+            * (1f + attacker.Attributes[Stats.ElementalAttackSuccessRateMultiplier]);
+        if (attackRate <= 0)
+        {
+            return 0f;
+        }
+
+        var defenseRate = defender.Attributes[Stats.ElementalDefenseSuccessRate]
+            * (1f + defender.Attributes[Stats.ElementalDefenseSuccessRateMultiplier]);
+        if (defenseRate <= 0)
+        {
+            return 1f;
+        }
+
+        if (attackRate < defenseRate)
+        {
+            return Rand.NextRandomBool(0.95f) ? 0f : 0.3f;
+        }
+
+        return Rand.NextRandomBool(defenseRate / attackRate) ? 0f : 1f;
+    }
+}
