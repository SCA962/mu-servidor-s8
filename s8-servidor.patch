+﻿// <copyright file="MiningResult.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.Mining;
+
+/// <summary>
+/// The result codes of the mining packets of the 'Jewel of Pandora' system.
+/// </summary>
+/// <remarks>
+/// The numbers are not ours: they come from the Season 8 client, whose strings map one to one onto
+/// them (see the research in <c>7-panel-de-mineria.md</c>). Keeping them is what lets the original
+/// client show the right message without a translation table.
+/// </remarks>
+public enum MiningResult
+{
+    /// <summary>
+    /// The attempt passed a stage between 1 and 4. The client opens the dialog which asks whether
+    /// to take the jewels or to keep mining.
+    /// </summary>
+    Success = 0,
+
+    /// <summary>
+    /// The attempt passed the fifth and last stage. The reward is paid right away, without a dialog.
+    /// </summary>
+    SuccessFinalStage = 1,
+
+    /// <summary>
+    /// The attempt failed. Everything accumulated in this chain is lost.
+    /// </summary>
+    Failed = 2,
+
+    /// <summary>
+    /// Somebody else is mining this zone.
+    /// </summary>
+    ZoneInUse = 3,
+
+    /// <summary>
+    /// The player is transformed into a monster.
+    /// </summary>
+    Transformed = 10,
+
+    /// <summary>
+    /// There is not enough free space in the inventory for the reward.
+    /// </summary>
+    NotEnoughSpace = 11,
+
+    /// <summary>
+    /// The player is trading or buying.
+    /// </summary>
+    Busy = 12,
+
+    /// <summary>
+    /// The player has a private store open.
+    /// </summary>
+    PrivateStoreOpen = 13,
+
+    /// <summary>
+    /// The stage or the zone of the request doesn't match what the server has. Anti cheat.
+    /// </summary>
+    StateMismatch = 17,
+
+    /// <summary>
+    /// No Pandora Pick equipped in the right hand, or its durability is below the cost of one attempt.
+    /// </summary>
+    NoPickOrDurability = 18,
+}
