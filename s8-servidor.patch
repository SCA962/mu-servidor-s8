+﻿// <copyright file="PentagramStorage.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic;
+
+/// <summary>
+/// The one-slot storage which holds the pentagram the character is wearing.
+/// </summary>
+/// <remarks>
+/// Es exactamente el patron de <see cref="ShopStorage"/>, que lleva anos funcionando: una vista con
+/// desplazamiento sobre el mismo <c>Character.Inventory</c>, no un almacen aparte. Por eso el
+/// pentagrama no necesita ni tabla nueva, ni columna nueva, ni migracion: es una fila mas de
+/// <c>ItemStorage.Items</c> con <c>ItemSlot</c> 236.
+/// </remarks>
+public class PentagramStorage : Storage
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="PentagramStorage"/> class.
+    /// </summary>
+    /// <param name="character">The character.</param>
+    public PentagramStorage(Character character)
+        : base(
+            1,
+            0,
+            InventoryConstants.PentagramSlot,
+            new ItemStorageAdapter(
+                character.Inventory ?? throw Error.NotInitializedProperty(character, nameof(Character.Inventory)),
+                InventoryConstants.PentagramSlot,
+                1))
+    {
+    }
+
+    /// <summary>
+    /// Occurs when the pentagram was put on or taken off.
+    /// </summary>
+    /// <remarks>
+    /// No se reusa <c>EquippedItemsChanged</c> del inventario a proposito: ese evento dispara
+    /// tambien el cambio de apariencia, y el paquete de apariencia tiene tamano fijo y no conoce
+    /// este hueco. El pentagrama no se ve puesto en el personaje, asi que solo hay que rehacer
+    /// atributos, no avisar a los demas jugadores.
+    /// </remarks>
+    public event AsyncEventHandler<ItemEventArgs>? PentagramChanged;
+
+    /// <summary>
+    /// Gets the pentagram which the character is wearing, if there is one.
+    /// </summary>
+    public Item? EquippedPentagram => this.GetItem(InventoryConstants.PentagramSlot);
+
+    /// <inheritdoc/>
+    public override async ValueTask<bool> AddItemAsync(byte slot, Item item)
+    {
+        var added = await base.AddItemAsync(slot, item).ConfigureAwait(false);
+        if (added)
+        {
+            await this.PentagramChanged.SafeInvokeAsync(new ItemEventArgs(item, true)).ConfigureAwait(false);
+        }
+
+        return added;
+    }
+
+    /// <inheritdoc/>
+    public override async ValueTask RemoveItemAsync(Item item)
+    {
+        await base.RemoveItemAsync(item).ConfigureAwait(false);
+        await this.PentagramChanged.SafeInvokeAsync(new ItemEventArgs(item, false)).ConfigureAwait(false);
+    }
+}
