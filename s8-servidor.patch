+    /// <summary>
+    /// Ties one boss material to the monster which drops it.
+    /// </summary>
+    /// <param name="monsterNumber">The number of the monster which drops it.</param>
+    /// <param name="itemNumber">The number of the material inside item group 14.</param>
+    /// <param name="description">The description of the group.</param>
+    /// <remarks>
+    /// It quietly does nothing if the monster or the item isn't there, so that a partially
+    /// initialized configuration can't make the map initializer throw.
+    /// </remarks>
+    private void CreateBossMaterialDropGroup(short monsterNumber, short itemNumber, string description)
+    {
+        var monster = this.GameConfiguration.Monsters.FirstOrDefault(m => m.Number == monsterNumber);
+        var item = this.GameConfiguration.Items.FirstOrDefault(i => i.Group == 14 && i.Number == itemNumber);
+        if (monster is null || item is null)
+        {
+            return;
+        }
+
+        var dropItemGroup = this.Context.CreateNew<DropItemGroup>();
+        dropItemGroup.SetGuid(Number, monsterNumber);
+        dropItemGroup.Chance = 0.001;
+        dropItemGroup.Description = description;
+        dropItemGroup.Monster = monster;
+        dropItemGroup.PossibleItems.Add(item);
+
+        monster.DropItemGroups.Add(dropItemGroup);
+        this.GameConfiguration.DropItemGroups.Add(dropItemGroup);
+    }
+}
