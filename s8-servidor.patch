+﻿// <copyright file="Acheron2.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.Persistence.Initialization.VersionSeasonSix.Maps;
+
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.DataModel.Entities;
+using MUnique.OpenMU.Persistence.Initialization.Items;
+
+/// <summary>
+/// The initialization for the Acheron 2 map.
+/// </summary>
+internal class Acheron2 : BaseMapInitializer
+{
+    /// <summary>
+    /// The Number of the Map.
+    /// </summary>
+    internal const byte Number = 92;
+
+    /// <summary>
+    /// The Name of the Map.
+    /// </summary>
+    internal const string Name = "Acheron 2";
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="Acheron2"/> class.
+    /// </summary>
+    /// <param name="context">The context.</param>
+    /// <param name="gameConfiguration">The game configuration.</param>
+    public Acheron2(IContext context, GameConfiguration gameConfiguration)
+        : base(context, gameConfiguration)
+    {
+    }
+
+    /// <inheritdoc/>
+    protected override byte MapNumber => Number;
+
+    /// <inheritdoc/>
+    protected override string MapName => Name;
+
+    /// <inheritdoc/>
+    protected override IEnumerable<MonsterSpawnArea> CreateNpcSpawns()
+    {
+        // El unico habitante fijo del mapa. Va en la misma coordenada que el Jin de Acheron 1, pero es
+        // otro NPC (604, no 583): el paquete separa los dos para poder darles surtidos distintos.
+        yield return this.CreateMonsterSpawn(1, this.NpcDictionary[604], 056, 202, Direction.South); // Jin
+    }
+
+    /// <inheritdoc/>
+    protected override IEnumerable<MonsterSpawnArea> CreateMonsterSpawns()
+    {
+        // Vacio a proposito: Data/MonsterSetBase/092 - Acheron 2.txt trae solo la seccion de NPC y
+        // termina en "end", sin bloque MONSTERS. Acheron 2 es el gemelo de evento de Acheron 1 y la
+        // poblacion la mete el evento, no la tabla base. Si algun dia aparece el bloque, va aqui.
+        yield break;
+    }
+
+    /// <inheritdoc/>
+    protected override void CreateMonsters()
+    {
+        {
+            var def = this.Context.CreateNew<MonsterDefinition>();
+            this.GameConfiguration.Monsters.Add(def);
+            def.Number = 604;
+            def.Designation = "Jin";
+            def.ObjectKind = NpcObjectKind.PassiveNpc;
+            def.NpcWindow = NpcWindow.Merchant;
+            def.MerchantStore = this.CreateJinStore();
+            def.SetGuid(def.Number);
+        }
+    }
+
+    /// <summary>
+    /// Crea la tienda del Jin de Acheron 2. No se reutiliza la de Acheron 1 porque el surtido no es el
+    /// mismo: Data/Shop/026 - Jin.txt (NPC 604, segun ShopManager.txt) trae dos articulos y el 025
+    /// trae tres. Aqui no se vende el Tradeable Seal.
+    /// </summary>
+    /// <returns>La tienda.</returns>
+    private ItemStorage CreateJinStore()
+    {
+        var itemHelper = new ItemHelper(this.Context, this.GameConfiguration);
+        var store = this.Context.CreateNew<ItemStorage>();
+
+        store.Items.Add(itemHelper.CreateItem(0, 150, 12, 1, 0));   // Jewel Combination Frame
+        store.Items.Add(itemHelper.CreateItem(1, 151, 12, 1, 0));   // Spirit Powder
+
+        store.SetGuid(604);
+        return store;
+    }
+}
