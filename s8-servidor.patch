+    private ItemOptionDefinition CreateElementOptions()
+    {
+        var definition = this.Context.CreateNew<ItemOptionDefinition>();
+        definition.SetGuid(ItemOptionDefinitionNumbers.Pentagram);
+        this.GameConfiguration.ItemOptions.Add(definition);
+        definition.Name = "Pentagram Element";
+        definition.AddsRandomly = true;
+        definition.AddChance = 1.0f;
+        definition.MaximumOptionsPerItem = 1;
+
+        var elements = new[] { "Fire", "Water", "Earth", "Wind", "Dark" };
+        for (short i = 0; i < elements.Length; i++)
+        {
+            var itemOption = this.Context.CreateNew<IncreasableItemOption>();
+            itemOption.SetGuid(ItemOptionDefinitionNumbers.Pentagram, (short)(i + 1));
+            itemOption.OptionType = this.GameConfiguration.ItemOptionTypes.First(t => t == ItemOptionTypes.PentagramElement);
+            itemOption.Number = (short)(i + 1);
+            itemOption.Weight = 20;
+
+            var powerUpDefinition = this.Context.CreateNew<PowerUpDefinition>();
+            powerUpDefinition.TargetAttribute = Stats.Element.GetPersistent(this.GameConfiguration);
+            powerUpDefinition.Boost = this.Context.CreateNew<PowerUpDefinitionValue>();
+            powerUpDefinition.Boost.ConstantValue.Value = i + 1;
+            powerUpDefinition.Boost.ConstantValue.AggregateType = AggregateType.AddRaw;
+            itemOption.PowerUpDefinition = powerUpDefinition;
+
+            definition.PossibleOptions.Add(itemOption);
+        }
+
+        return definition;
+    }
