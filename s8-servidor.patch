+        this.CreateSimpleItem(12, 144, "Mithril Fragment", 1, 1);
+        this.CreateSimpleItem(12, 146, "Elixir Fragment", 1, 1);
+        this.CreateSimpleItem(12, 150, "Jewel Combination Frame", 2, 1);
+        this.CreateSimpleItem(12, 151, "Spirit Powder", 1, 2);
+
+        // Lo tercero que vende Jin en Acheron (Data/Shop/025 - Jin.txt). Comprobado que tiene ficha
+        // en la tabla del cliente: 14/209 "Tradeable Seal", modelo TIstamp.bmd.
+        this.CreateSimpleItem(14, 209, "Tradeable Seal", 1, 1);
+
+        // Access to Acheron. Both are inert for now: the 5 fragments to 1 map stacking rule and the
+        // NPC which takes the map don't exist yet.
+        this.CreateSimpleItem(13, 145, "Spirit Map Fragment", 1, 1);
+        this.CreateSimpleItem(13, 146, "Spirit Map", 1, 1);
+
+        // Boss materials. The package drops them from the Raklion bosses (Data/Item/ItemDrop.txt,
+        // monsters 454-458 and 562-565); those nine drop groups are NOT wired here, see the report.
+        this.CreateSimpleItem(14, 176, "Death King's Bone", 1, 1);
+        this.CreateSimpleItem(14, 177, "Hell Maine's Leather", 1, 1);
+        this.CreateSimpleItem(14, 178, "Dark Phoenix Flame", 1, 1);
+        this.CreateSimpleItem(14, 179, "Death Beam Knight Soul", 1, 1);
+        this.CreateSimpleItem(14, 180, "Ice Walker's Mane", 1, 1);
+        this.CreateSimpleItem(14, 181, "Mammoth's Bundle of Fur", 1, 1);
+        this.CreateSimpleItem(14, 182, "Giant's Icicle", 1, 2);
+        this.CreateSimpleItem(14, 183, "Coolutin's Poison", 1, 1);
