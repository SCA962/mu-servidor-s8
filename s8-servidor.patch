+    private ItemDefinition CreateSeasonEightConsumable(byte group, short number, string name, byte width, byte height, byte durability, byte subType, MagicEffectNumber? effectNumber, params (AttributeDefinition TargetAttribute, float BoostValue, AggregateType AggregateType)[] boosts)
+    {
+        var item = this.Context.CreateNew<ItemDefinition>();
+        item.Name = name;
+        item.Group = group;
+        item.Number = number;
+        item.Width = width;
+        item.Height = height;
+        item.Durability = durability;
+        item.DropsFromMonsters = false;
+        item.SetGuid(item.Group, item.Number);
+        this.GameConfiguration.Items.Add(item);
+
+        if (effectNumber is { } number2)
+        {
+            // Every one of these lasts 1800 seconds in Data/Effect/Effect.txt.
+            this.CreateConsumeEffect(item, subType, number2, TimeSpan.FromSeconds(1800), boosts);
+        }
+
+        return item;
     }
 
