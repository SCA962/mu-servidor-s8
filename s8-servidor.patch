+﻿// <copyright file="MiningState.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.GameLogic.Mining;
+
+using MUnique.OpenMU.GameLogic.NPC;
+
+/// <summary>
+/// The state of a mining chain of one player on one zone.
+/// </summary>
+/// <remarks>
+/// It only lives while the player is connected and standing on a chain. It's deliberately not
+/// persisted: the original loses everything accumulated when the player disconnects before taking
+/// the jewels, and so do we.
+/// </remarks>
+public sealed class MiningState
+{
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MiningState"/> class.
+    /// </summary>
+    /// <param name="zone">The zone which is being mined.</param>
+    /// <param name="configuration">The numbers of that zone size.</param>
+    public MiningState(MiningZone zone, MiningZoneConfiguration configuration)
+    {
+        this.Zone = zone;
+        this.Configuration = configuration;
+    }
+
+    /// <summary>
+    /// Gets the zone which is being mined.
+    /// </summary>
+    public MiningZone Zone { get; }
+
+    /// <summary>
+    /// Gets the numbers of the zone size.
+    /// </summary>
+    public MiningZoneConfiguration Configuration { get; }
+
+    /// <summary>
+    /// Gets or sets the stage which the chain has reached, 0 before the first hit.
+    /// </summary>
+    public byte Stage { get; set; }
+
+    /// <summary>
+    /// Gets or sets the jewels accumulated so far, which are lost on a failed attempt.
+    /// </summary>
+    public int JewelCount { get; set; }
+
+    /// <summary>
+    /// Gets or sets a value indicating whether the player is being asked to take the jewels or to
+    /// keep mining. While this is set, only a reward answer is accepted.
+    /// </summary>
+    public bool WaitingForDecision { get; set; }
+}
