+﻿// <copyright file="AddSeasonEightItemsAndDropsUpdatePlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.Persistence.Initialization.Updates;
+
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.DataModel.Configuration.Items;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// Adds the Season 8 items which need no new system, and the drops of Acheron, to an existing
+/// Season 6 database.
+/// </summary>
+/// <remarks>
+/// All of this lives in the item initializers, which only run when a database is created from
+/// scratch. This update seeds the same content into a database which is already running:
+///   six premium wings (12/262 to 12/267),
+///   four transformation rings (13/77, 13/78, 13/163, 13/164),
+///   seven "unique" accessories (13/169 to 13/176),
+///   six crafting materials and thirteen boss materials,
+///   fifteen consumables with a timed effect,
+///   the four drop groups of Acheron, the global Spirit Map Fragment group and the nine boss
+///   material drop groups of Raklion.
+/// The reasoning and the sources for every number are in
+/// servidor/estudios/conversor-s8/lo-que-falta/5-items-y-drops-hechos.md.
+/// </remarks>
+[PlugIn]
+[Display(Name = PlugInName, Description = PlugInDescription)]
+[Guid("3F1C7A46-92D8-4B05-9E63-5A7D0C81E4B2")]
+public class AddSeasonEightItemsAndDropsUpdatePlugIn : UpdatePlugInBase
+{
+    /// <summary>
+    /// The plug-in name.
+    /// </summary>
+    internal const string PlugInName = "Add Season 8 items and drops";
+
+    /// <summary>
+    /// The plug-in description.
+    /// </summary>
+    internal const string PlugInDescription = "This update adds the Season 8 items which need no new system (premium wings, transformation rings, accessories, materials and timed-effect consumables), the drops of Acheron and the boss material drops of Raklion.";
+
+    /// <summary>
+    /// The number of the first premium wing; it is used to tell whether this update already ran.
+    /// </summary>
+    private const short CloakOfDeathNumber = 262;
+
+    /// <inheritdoc />
+    public override string Name => PlugInName;
+
+    /// <inheritdoc />
+    public override string Description => PlugInDescription;
+
+    /// <inheritdoc />
+    public override UpdateVersion Version => UpdateVersion.AddSeasonEightItemsAndDrops;
+
+    /// <inheritdoc />
+    public override string DataInitializationKey => VersionSeasonSix.DataInitialization.Id;
+
+    /// <inheritdoc />
+    public override bool IsMandatory => false;
+
+    /// <inheritdoc />
+    public override DateTime CreatedAt => new(2026, 09, 16, 2, 0, 0, DateTimeKind.Utc);
+
+    /// <inheritdoc />
+    protected override ValueTask ApplyAsync(IContext context, GameConfiguration gameConfiguration)
+    {
+        if (gameConfiguration.Items.Any(item => item.Group == 12 && item.Number == CloakOfDeathNumber))
+        {
+            // Already there, nothing to do.
+            return ValueTask.CompletedTask;
+        }
+
+        new WingsSeeder(context, gameConfiguration).Seed();
+        new JewelerySeeder(context, gameConfiguration).Seed();
+        new MiscSeeder(context, gameConfiguration).Seed();
+        new PotionsSeeder(context, gameConfiguration).Seed();
+
+        AddSpiritMapFragmentDropGroup(context, gameConfiguration);
+        AddAcheronDropGroups(context, gameConfiguration);
+        AddRaklionBossMaterialDropGroups(context, gameConfiguration);
+
+        return ValueTask.CompletedTask;
+    }
+
+    /// <summary>
+    /// Ties the nine boss materials to the Raklion bosses which drop them.
+    /// </summary>
+    /// <remarks>
+    /// Data/Item/ItemDrop.txt of the Season 8 package, the nine rows with a MonsterClass of 454 to
+    /// 458 and 562 to 565, all with DropRate 1000 (0.1 %). A monster bound group is read straight
+    /// from MonsterDefinition.DropItemGroups by the drop generator, so it only has to be hung on
+    /// the monster.
+    /// </remarks>
+    private static void AddRaklionBossMaterialDropGroups(IContext context, GameConfiguration gameConfiguration)
+    {
+        (short MonsterNumber, short ItemNumber, string Description)[] groups =
+        [
+            (454, 180, "Ice Walker's Mane"),
+            (455, 181, "Mammoth's Bundle of Fur"),
+            (456, 182, "Giant's Icicle"),
+            (457, 183, "Coolutin's Poison"),
+            (458, 184, "Iron Knight's Heart"),
+            (562, 185, "Dark Mammoth's Horn"),
+            (563, 186, "Dark Giant's Axe"),
+            (564, 187, "Dark Coolutin's Blood"),
+            (565, 188, "Dark Iron Knight's Sword"),
+        ];
+
+        foreach (var (monsterNumber, itemNumber, description) in groups)
+        {
+            var monster = gameConfiguration.Monsters.FirstOrDefault(m => m.Number == monsterNumber);
+            var item = gameConfiguration.Items.FirstOrDefault(i => i.Group == 14 && i.Number == itemNumber);
+            if (monster is null || item is null)
+            {
+                continue;
+            }
+
+            var groupId = GuidHelper.CreateGuid<DropItemGroup>(VersionSeasonSix.Maps.Raklion.Number, monsterNumber);
+            if (gameConfiguration.DropItemGroups.Any(g => g.GetId() == groupId))
+            {
+                continue;
+            }
+
+            var group = context.CreateNew<DropItemGroup>();
+            group.SetGuid(VersionSeasonSix.Maps.Raklion.Number, monsterNumber);
+            group.Chance = 0.001;
+            group.Description = description;
+            group.Monster = monster;
+            group.PossibleItems.Add(item);
+            monster.DropItemGroups.Add(group);
+            gameConfiguration.DropItemGroups.Add(group);
+        }
+    }
+
+    /// <summary>
+    /// Adds the global drop group of the Spirit Map Fragment to every map.
+    /// </summary>
+    /// <remarks>
+    /// <see cref="BaseMapInitializer.RegisterDefaultDropItemGroup"/> only fills a static list which
+    /// is read while a database is being created. On a running database the group has to be hung on
+    /// each existing map, because <c>DefaultDropGenerator</c> only looks at the drop groups of the
+    /// monster, the character and the map, never at the global list.
+    /// </remarks>
+    private static void AddSpiritMapFragmentDropGroup(IContext context, GameConfiguration gameConfiguration)
+    {
+        var fragment = gameConfiguration.Items.FirstOrDefault(item => item.Group == 13 && item.Number == 145);
+        if (fragment is null)
+        {
+            return;
+        }
+
+        var groupId = GuidHelper.CreateGuid<DropItemGroup>(13, 145);
+        var group = gameConfiguration.DropItemGroups.FirstOrDefault(g => g.GetId() == groupId);
+        if (group is null)
+        {
+            group = context.CreateNew<DropItemGroup>();
+            group.SetGuid(13, 145);
+            group.Chance = 0.003;
+            group.Description = "The drop item group for the Spirit Map Fragment";
+            group.MinimumMonsterLevel = 25;
+            group.MaximumMonsterLevel = 150;
+            group.PossibleItems.Add(fragment);
+            gameConfiguration.DropItemGroups.Add(group);
+        }
+
+        foreach (var map in gameConfiguration.Maps)
+        {
+            if (!map.DropItemGroups.Any(g => g.GetId() == groupId))
+            {
+                map.DropItemGroups.Add(group);
+            }
+        }
+    }
+
+    /// <summary>
+    /// Adds the four mix material drop groups of Acheron to the map which already exists.
+    /// </summary>
+    private static void AddAcheronDropGroups(IContext context, GameConfiguration gameConfiguration)
+    {
+        var map = gameConfiguration.Maps.FirstOrDefault(m => m.Number == VersionSeasonSix.Maps.Acheron.Number && m.Discriminator == 0);
+        if (map is null)
+        {
+            return;
+        }
+
+        (byte Number, byte ItemGroup, short ItemNumber, string Description, double Chance)[] groups =
+        [
+            (1, 12, 144, "Mithril Fragment", 0.02),
+            (2, 12, 146, "Elixir Fragment", 0.0025),
+            (3, 12, 150, "Jewel Combination Frame", 0.001),
+            (4, 12, 151, "Spirit Powder", 0.001),
+        ];
+
+        foreach (var (number, itemGroup, itemNumber, description, chance) in groups)
+        {
+            var item = gameConfiguration.Items.FirstOrDefault(i => i.Group == itemGroup && i.Number == itemNumber);
+            if (item is null)
+            {
+                continue;
+            }
+
+            var groupId = GuidHelper.CreateGuid<DropItemGroup>(VersionSeasonSix.Maps.Acheron.Number, number);
+            var group = gameConfiguration.DropItemGroups.FirstOrDefault(g => g.GetId() == groupId);
+            if (group is null)
+            {
+                group = context.CreateNew<DropItemGroup>();
+                group.SetGuid(VersionSeasonSix.Maps.Acheron.Number, number);
+                group.Chance = chance;
+                group.Description = description;
+                group.MinimumMonsterLevel = 88;
+                group.MaximumMonsterLevel = 150;
+                group.PossibleItems.Add(item);
+                gameConfiguration.DropItemGroups.Add(group);
+            }
+
+            if (!map.DropItemGroups.Any(g => g.GetId() == groupId))
+            {
+                map.DropItemGroups.Add(group);
+            }
+        }
+    }
+
+    /// <summary>
+    /// Creates the six premium wings through the initializer which also creates them from scratch.
+    /// </summary>
+    private sealed class WingsSeeder : VersionSeasonSix.Items.Wings
+    {
+        public WingsSeeder(IContext context, GameConfiguration gameConfiguration)
+            : base(context, gameConfiguration)
+        {
+        }
+
+        public void Seed()
+        {
+            // The wings reuse the "3rd Wing Options" definition, which has a deterministic id and
+            // is already in the database. Creating it again would collide.
+            var optionsId = GuidHelper.CreateGuid<ItemOptionDefinition>(ItemOptionDefinitionNumbers.Wing3rd);
+            var thirdWingOptions = this.GameConfiguration.ItemOptions.FirstOrDefault(o => o.GetId() == optionsId)
+                                   ?? this.CreateThirdClassWingOptions();
+            this.CreateSeasonEightWings(thirdWingOptions);
+        }
+    }
+
+    /// <summary>
+    /// Creates the transformation rings and the unique accessories.
+    /// </summary>
+    private sealed class JewelerySeeder : VersionSeasonSix.Items.Jewelery
+    {
+        public JewelerySeeder(IContext context, GameConfiguration gameConfiguration)
+            : base(context, gameConfiguration)
+        {
+        }
+
+        public void Seed()
+        {
+            // Neither of the two needs the state which Initialize would build: the transformation
+            // rings bring their own level bonus table, and the accessories are created without the
+            // jewelery health option and without a resistance.
+            this.CreateSeasonEightTransformationRings();
+            this.CreateSeasonEightAccessories();
+        }
+    }
+
+    /// <summary>
+    /// Creates the crafting and boss materials.
+    /// </summary>
+    private sealed class MiscSeeder : VersionSeasonSix.Items.Misc
+    {
+        public MiscSeeder(IContext context, GameConfiguration gameConfiguration)
+            : base(context, gameConfiguration)
+        {
+        }
+
+        public void Seed() => this.CreateSeasonEightMaterials();
+    }
+
+    /// <summary>
+    /// Creates the consumables with a timed effect and their magic effect definitions.
+    /// </summary>
+    private sealed class PotionsSeeder : VersionSeasonSix.Items.Potions
+    {
+        public PotionsSeeder(IContext context, GameConfiguration gameConfiguration)
+            : base(context, gameConfiguration)
+        {
+        }
+
+        public void Seed() => this.CreateSeasonEightConsumables();
+    }
+}
