+/// <summary>
+/// The default implementation of the <see cref="IMiningViewPlugIn"/>, which sends the answers of
+/// the 'Jewel of Pandora' mining system to the game client.
+/// </summary>
+[PlugIn]
+[Display(Name = "Mining View PlugIn", Description = "Sends the answers of the Jewel of Pandora mining system to the game client.")]
+[Guid("E6765C8D-341C-4BC1-81B5-D6588478D60E")]
+[MinimumClient(6, 3, ClientLanguage.Invariant)]
+public class MiningViewPlugIn : IMiningViewPlugIn
+{
+    private readonly RemotePlayer _player;
+
+    /// <summary>
+    /// Initializes a new instance of the <see cref="MiningViewPlugIn"/> class.
+    /// </summary>
+    /// <param name="player">The player.</param>
+    public MiningViewPlugIn(RemotePlayer player) => this._player = player;
+
+    /// <inheritdoc />
+    public async ValueTask ShowMiningHitResultAsync(ushort zoneId, ushort zoneClass, byte mapNumber, byte stage, int jewelCount, MiningResult result)
+    {
+        if (this._player.Connection is not { Connected: true } connection)
+        {
+            return;
+        }
+
+        await connection.SendMiningHitResultAsync(
+            this._player.GetId(this._player),
+            zoneId,
+            zoneClass,
+            mapNumber,
+            stage,
+            (uint)Math.Max(jewelCount, 0),
+            (uint)result).ConfigureAwait(false);
+    }
+
+    /// <inheritdoc />
+    public async ValueTask ShowMiningRewardResultAsync(ushort zoneId, ushort zoneClass, byte mapNumber, byte stage, MiningResult result)
+    {
+        if (this._player.Connection is not { Connected: true } connection)
+        {
+            return;
+        }
+
+        await connection.SendMiningRewardResultAsync(
+            this._player.GetId(this._player),
+            zoneId,
+            zoneClass,
+            mapNumber,
+            stage,
+            (uint)result).ConfigureAwait(false);
+    }
+}
