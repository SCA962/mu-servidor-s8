+﻿// <copyright file="AddPandoraMiningSystemUpdatePlugIn.cs" company="MUnique">
+// Licensed under the MIT License. See LICENSE file in the project root for full license information.
+// </copyright>
+
+namespace MUnique.OpenMU.Persistence.Initialization.Updates;
+
+using System.Runtime.InteropServices;
+using MUnique.OpenMU.AttributeSystem;
+using MUnique.OpenMU.DataModel.Configuration;
+using MUnique.OpenMU.GameLogic.Attributes;
+using MUnique.OpenMU.PlugIns;
+
+/// <summary>
+/// Adds the 'Jewel of Pandora' mining system of Season 8 to an existing Season 6 database.
+/// </summary>
+/// <remarks>
+/// The map initializers only run when a database is created from scratch, so an existing server
+/// gets the three mining zones (605 to 607), their 42 placements and the Pandora Pick in the store
+/// of the Weapons Merchant Bolo from here.
+/// The coordinates are the ones of the Season 8 server package (<c>Data/MonsterSetBase/</c>), which
+/// sit on the spawn gate of each of the five maps.
+/// </remarks>
+[PlugIn]
+[Display(Name = PlugInName, Description = PlugInDescription)]
+[Guid("66883D60-E6E4-4571-A4B2-A301C2273551")]
+public class AddPandoraMiningSystemUpdatePlugIn : UpdatePlugInBase
+{
+    /// <summary>
+    /// The plug-in name.
+    /// </summary>
+    internal const string PlugInName = "Add the Jewel of Pandora mining system";
+
+    /// <summary>
+    /// The plug-in description.
+    /// </summary>
+    internal const string PlugInDescription = "This update adds the three mining zones of the Jewel of Pandora system, their 42 placements on Lost Tower, Tarkan, Aida, Swamp of Calmness and Raklion, and the Pandora Pick in the store of the Weapons Merchant Bolo.";
+
+    /// <summary>
+    /// The first spawn number of the mining zones. Chosen well above everything which the five map
+    /// initializers use today, so that the deterministic spawn ids can't collide.
+    /// </summary>
+    private const short FirstSpawnNumber = 2000;
+
+    /// <summary>
+    /// The item slot of the Pandora Pick inside the store of Bolo. Slot 4 is the only free one
+    /// between his six weapons.
+    /// </summary>
+    private const byte PandoraPickStoreSlot = 4;
+
+    /// <summary>
+    /// The monster number of the Weapons Merchant Bolo.
+    /// </summary>
+    private const short BoloNumber = 578;
+
+    /// <summary>
+    /// The three zones: monster number, designation and respawn delay in seconds, from
+    /// <c>Data/Monster/Monster.txt:564-566</c> of the package.
+    /// </summary>
+    private static readonly (short Number, string Designation, int RespawnSeconds)[] Zones =
+    {
+        (605, "Mining Area (Small)", 10),
+        (606, "Mining Area (Medium)", 20),
+        (607, "Mining Area (Large)", 30),
+    };
+
+    /// <summary>
+    /// The 42 placements: map number, spawn number, monster number, x and y.
+    /// </summary>
+    private static readonly (byte Map, short Number, short Monster, byte X, byte Y)[] Spawns =
+    {
+        (4, 2000, 605, 202, 75),
+        (4, 2001, 605, 206, 80),
+        (4, 2002, 605, 211, 80),
+        (4, 2003, 606, 212, 76),
+        (4, 2004, 606, 208, 72),
+        (4, 2005, 607, 207, 76),
+        (8, 2000, 605, 188, 54),
+        (8, 2001, 605, 198, 64),
+        (8, 2002, 605, 206, 72),
+        (8, 2003, 605, 206, 55),
+        (8, 2004, 605, 186, 60),
+        (8, 2005, 606, 164, 58),
+        (8, 2006, 606, 197, 57),
+        (8, 2007, 606, 192, 73),
+        (8, 2008, 606, 203, 65),
+        (8, 2009, 607, 205, 59),
+        (8, 2010, 607, 201, 70),
+        (8, 2011, 607, 199, 56),
+        (33, 2000, 605, 83, 15),
+        (33, 2001, 605, 76, 9),
+        (33, 2002, 605, 88, 7),
+        (33, 2003, 606, 91, 12),
+        (33, 2004, 606, 83, 12),
+        (33, 2005, 607, 79, 10),
+        (56, 2000, 605, 139, 113),
+        (56, 2001, 605, 145, 109),
+        (56, 2002, 605, 143, 99),
+        (56, 2003, 605, 135, 100),
+        (56, 2004, 605, 130, 111),
+        (56, 2005, 606, 134, 105),
+        (56, 2006, 606, 142, 105),
+        (56, 2007, 606, 138, 109),
+        (56, 2008, 606, 137, 101),
+        (56, 2009, 607, 141, 105),
+        (56, 2010, 607, 145, 119),
+        (56, 2011, 607, 142, 109),
+        (57, 2000, 605, 211, 208),
+        (57, 2001, 605, 220, 203),
+        (57, 2002, 605, 222, 208),
+        (57, 2003, 606, 223, 203),
+        (57, 2004, 606, 217, 208),
+        (57, 2005, 607, 224, 221),
+    };
+
+    /// <inheritdoc />
+    public override string Name => PlugInName;
+
+    /// <inheritdoc />
+    public override string Description => PlugInDescription;
+
+    /// <inheritdoc />
+    public override UpdateVersion Version => UpdateVersion.AddPandoraMiningSystem;
+
+    /// <inheritdoc />
+    public override string DataInitializationKey => VersionSeasonSix.DataInitialization.Id;
+
+    /// <inheritdoc />
+    public override bool IsMandatory => false;
+
+    /// <inheritdoc />
+    public override DateTime CreatedAt => new(2026, 09, 16, 20, 0, 0, DateTimeKind.Utc);
+
+    /// <inheritdoc />
+    protected override ValueTask ApplyAsync(IContext context, GameConfiguration gameConfiguration)
+    {
+        this.AddMiningZones(context, gameConfiguration);
+        this.AddSpawns(context, gameConfiguration);
+        this.AddPandoraPickToBoloStore(context, gameConfiguration);
+        FixPandoraPickDefinition(gameConfiguration);
+        return ValueTask.CompletedTask;
+    }
+
+    /// <summary>
+    /// The pick doesn't drop from monsters: <c>Data/Item/Item.txt:44</c> of the package says
+    /// <c>DropItem 0</c>. It was added with the flag set, so an existing database has it wrong.
+    /// </summary>
+    /// <param name="gameConfiguration">The game configuration.</param>
+    private static void FixPandoraPickDefinition(GameConfiguration gameConfiguration)
+    {
+        if (gameConfiguration.Items.FirstOrDefault(i => i is { Group: 0, Number: 41 }) is { } pick)
+        {
+            pick.DropsFromMonsters = false;
+
+            // Y no sube de nivel: cualquier joya de nivel que acierte pone la durabilidad al
+            // maximo, o sea que una Jewel of Soul reparaba el pico entero y el sumidero de Bless
+            // dejaba de existir. Con el maximo a 0, CanLevelBeUpgraded() las corta todas.
+            pick.MaximumItemLevel = 0;
+        }
+    }
+
+    private void AddMiningZones(IContext context, GameConfiguration gameConfiguration)
+    {
+        foreach (var (number, designation, respawnSeconds) in Zones)
+        {
+            if (gameConfiguration.Monsters.Any(m => m.Number == number))
+            {
+                continue;
+            }
+
+            var def = context.CreateNew<MonsterDefinition>();
+            gameConfiguration.Monsters.Add(def);
+            def.Number = number;
+            def.Designation = designation;
+            def.ObjectKind = NpcObjectKind.MiningZone;
+            def.Attribute = 1;
+            def.RespawnDelay = new TimeSpan(respawnSeconds * TimeSpan.TicksPerSecond);
+            def.NumberOfMaximumItemDrops = 0;
+            var attributes = new Dictionary<AttributeDefinition, float>
+            {
+                { Stats.Level, 1 },
+                { Stats.MaximumHealth, 5 },
+            };
+            def.AddAttributes(attributes, context, gameConfiguration);
+            def.SetGuid(def.Number);
+        }
+    }
+
+    /// <summary>
+    /// Adds the 42 placements to the maps which already exist in the database.
+    /// </summary>
+    /// <param name="context">The context.</param>
+    /// <param name="gameConfiguration">The game configuration.</param>
+    /// <remarks>
+    /// The body of <c>BaseMapInitializer.CreateMonsterSpawn</c> is repeated here on purpose: that
+    /// helper assigns the map definition which the initializer creates itself, and it's only
+    /// reachable through the <c>CreateMonsterSpawns</c> iterator, which would re-create every spawn
+    /// of the map with the same deterministic ids that the database already has.
+    /// </remarks>
+    private void AddSpawns(IContext context, GameConfiguration gameConfiguration)
+    {
+        foreach (var (mapNumber, number, monsterNumber, x, y) in Spawns)
+        {
+            if (gameConfiguration.Maps.FirstOrDefault(m => m.Number == mapNumber && m.Discriminator == 0) is not { } map)
+            {
+                continue;
+            }
+
+            if (gameConfiguration.Monsters.FirstOrDefault(m => m.Number == monsterNumber) is not { } monster)
+            {
+                continue;
+            }
+
+            if (map.MonsterSpawns.Any(s => s.MonsterDefinition?.Number == monsterNumber && s.X1 == x && s.Y1 == y))
+            {
+                continue;
+            }
+
+            var area = context.CreateNew<MonsterSpawnArea>();
+            map.MonsterSpawns.Add(area);
+            area.SetGuid(map.Number, number);
+            area.GameMap = map;
+            area.MonsterDefinition = monster;
+            area.Quantity = 1;
+            area.Direction = Direction.SouthEast;
+            area.SpawnTrigger = SpawnTrigger.Automatic;
+            area.X1 = x;
+            area.X2 = x;
+            area.Y1 = y;
+            area.Y2 = y;
+        }
+    }
+
+    /// <summary>
+    /// Puts the Pandora Pick into the store of the Weapons Merchant Bolo, with durability 1 out of
+    /// 255 like the original, so that it has to be repaired with Jewels of Bless before it can be
+    /// used at all.
+    /// </summary>
+    /// <param name="context">The context.</param>
+    /// <param name="gameConfiguration">The game configuration.</param>
+    private void AddPandoraPickToBoloStore(IContext context, GameConfiguration gameConfiguration)
+    {
+        if (gameConfiguration.Monsters.FirstOrDefault(m => m.Number == BoloNumber) is not { MerchantStore: { } store })
+        {
+            return;
+        }
+
+        if (gameConfiguration.Items.FirstOrDefault(i => i is { Group: 0, Number: 41 }) is not { } pickDefinition)
+        {
+            return;
+        }
+
+        if (store.Items.Any(i => i.Definition?.Group == 0 && i.Definition?.Number == 41))
+        {
+            return;
+        }
+
+        if (store.Items.Any(i => i.ItemSlot == PandoraPickStoreSlot))
+        {
+            return;
+        }
+
+        var item = context.CreateNew<Item>();
+        store.Items.Add(item);
+        item.Definition = pickDefinition;
+        item.ItemSlot = PandoraPickStoreSlot;
+        item.Durability = 1;
+        item.Level = 0;
+    }
+}
